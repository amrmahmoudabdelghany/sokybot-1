<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.sokybot</groupId>
        <artifactId>sokybot</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sokybot-engine</artifactId>
    <packaging>bundle</packaging>

    <properties>
        <lombok.version>1.18.30</lombok.version>
	</properties>

    <dependencies>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-settings</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-engine-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>${project.parent.artifactId}-pk2</artifactId>
			<scope>compile</scope>
		</dependency>

        <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-security</artifactId>
			<scope>compile</scope>
		</dependency>
		
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-pk2-extractor</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

        <!-- Spring Boot dependencies removed - moved to sokybot-engine-legacy module -->

         <dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-commons</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-persistence</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring State Machine removed - moved to sokybot-engine-legacy module -->

        <dependency>
			<groupId>org.orbisgis</groupId>
			<artifactId>poly2tri-core</artifactId>
			<version>0.1.2</version>
		</dependency>

		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-transport</artifactId>
			<version>4.1.85.Final</version>
		</dependency>
		<dependency>
			<groupId>io.netty</groupId>
			<artifactId>netty-handler</artifactId>
			<version>4.1.85.Final</version>
		</dependency>
		
		<!-- picocli-spring-boot-starter removed - moved to sokybot-engine-legacy module -->
		<dependency>
			<groupId>org.apache.felix</groupId>
			<artifactId>org.apache.felix.atomos</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-loader</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-navigation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-model</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-asset</artifactId>
			<version>${project.version}</version>
		</dependency>
<!-- 
        <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-persistence</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
-->
		

		
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>5.3.31</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.name}</Bundle-Name>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Bundle-Activator>org.sokybot.engine.internal.EngineActivator</Bundle-Activator>
                        <Import-Package>
                            org.osgi.framework;version="[1.8,2.0)",
                            !javax.swing.*,
                            !java.awt.*,
                            *;resolution:=optional
                        </Import-Package>
                        <Private-Package>
                            org.sokybot.engine.internal,
                            org.sokybot.machine.*
                        </Private-Package>
                        <Export-Package>
                            org.sokybot.engine.core.*
                        </Export-Package>
                        <Embed-Dependency>
                            *;scope=compile|runtime;artifactId=!org.osgi.core&amp;!org.osgi.framework&amp;!org.osgi.compendium&amp;!sokybot-engine-api
                        </Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
