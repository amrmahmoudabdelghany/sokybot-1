<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.sokybot</groupId>
        <artifactId>sokybot</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sokybot-engine</artifactId>
    <packaging>bundle</packaging>

    <properties>
        <lombok.version>1.18.30</lombok.version>
	</properties>

    <dependencies>


        
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-engine-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-proxy</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>


        <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-security</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

        <dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-commons</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sokybot-persistence</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

		<dependency>
			<groupId>org.apache.felix</groupId>
			<artifactId>org.apache.felix.atomos</artifactId>
			<version>1.0.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-loader</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-model</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-game-asset</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
<!-- 
        <dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sokybot-persistence</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
-->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson YAML for actuator manifest parsing (provided by sokybot-jackson feature) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.15.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- OSGi DS annotations -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- Groovy for scripting -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.16</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.6.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.name}</Bundle-Name>
                        <Bundle-Version>${project.version}</Bundle-Version>

                        <Import-Package>
                            org.osgi.framework;version="[1.8,2.0)",
                            org.sokybot.engine.api.*;version="[1.0,2)",
                            org.sokybot.settings.api;version="[1.0,2)",
                            org.sokybot.settings.api.*;version="[1.0,2)",
                            org.sokybot.settings.security;version="[1.0,2)",
                            org.sokybot.settings;version="[1.0,2)",
                            org.sokybot.commons;version="[1.0,2)",
                            org.sokybot.commons.*;version="[1.0,2)",
                            org.sokybot.network;version="[1.0,2)",
                            org.sokybot.network.*;version="[1.0,2)",
                            !org.sokybot.gamemodel.spi,
                            org.sokybot.gamemodel.*;version="[1.0,2)",
                            org.sokybot.gameevents.*;version="[1.0,2)",
                            !javax.swing.*,
                            !java.awt.*,
                            *;resolution:=optional
                        </Import-Package>
                        <DynamicImport-Package>*</DynamicImport-Package>
                        <Private-Package>
                            org.sokybot.engine.internal,
                            org.sokybot.engine.internal.handler,
                            org.sokybot.engine.internal.behavior,
                            org.sokybot.engine.internal.login,
                            org.sokybot.engine.internal.journal,
                            org.sokybot.engine.internal.cycle,
                            org.sokybot.engine.internal.connection,
                            org.sokybot.machine.*
                        </Private-Package>
                        <Export-Package>
                            org.sokybot.engine.core.*,
                            org.sokybot.engine.core.workflow.builder,
                            org.sokybot.engine.plugin,
                            org.sokybot.engine.scripting
                        </Export-Package>
                        <!-- Only Groovy embedded (scripting); Jackson and Atomos from sokybot-jackson / sokybot-platform features -->
                        <Embed-Dependency>groovy;scope=compile;inline=true</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
