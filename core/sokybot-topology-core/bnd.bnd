Bundle-SymbolicName: ${project.groupId}.${project.artifactId}
Bundle-Name: ${project.name}
Bundle-Version: ${project.version}
Private-Package: org.sokybot.topology.core.internal
Import-Package: \
    org.sokybot.topology.api;version="[1.0,2)", \
    org.sokybot.navigation.api;version="[1.0,2)", \
    org.sokybot.persistence.entities;version="[1.0,2)", \
    org.sokybot.persistence.service;version="[1.0,2)", \
    org.osgi.service.component.annotations;version="[1.5,2)", \
    *;resolution:=optional
-dsannotations: *
