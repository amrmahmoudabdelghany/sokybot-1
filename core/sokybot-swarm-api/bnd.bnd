Bundle-SymbolicName: ${project.groupId}.${project.artifactId}
Bundle-Name: ${project.name}
Bundle-Version: ${project.version}
Bundle-Description: ${project.description}
Export-Package: org.sokybot.swarm.api
Private-Package: org.sokybot.swarm.api.internal
-dsannotations: *
Import-Package: \
    org.sokybot.commons.event;version="[1.0,2)", \
    reactor.core;version="[3.6,4)", \
    reactor.core.publisher;version="[3.6,4)", \
    *;resolution:=optional
