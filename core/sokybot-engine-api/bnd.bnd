Export-Package: org.sokybot.engine;version="${project.version}", org.sokybot.engine.api;version="${project.version}", org.sokybot.engine.api.behavior;version="${project.version}", org.sokybot.engine.api.event;version="${project.version}", org.sokybot.engine.api.extension;version="${project.version}", org.sokybot.engine.api.handler;version="${project.version}", org.sokybot.engine.api.workflow;version="${project.version}", org.sokybot.engine.api.login;version="${project.version}", org.sokybot.engine.api.*;version="${project.version}"
Import-Package: !com.aayushatharva.brotli4j, !com.aayushatharva.brotli4j.*, org.sokybot.proxy.*;version="[1.0,2)", org.sokybot.settings.*;version="[1.0,2)", org.sokybot.gamemodel.*;version="[1.0,2)", *;resolution:=optional
