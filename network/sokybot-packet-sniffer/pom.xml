<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sokybot</groupId>
		<artifactId>sokybot</artifactId>
		<version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>

	</parent>

	<artifactId>sokybot-packet-sniffer</artifactId>
	<packaging>bundle</packaging>


	<dependencies>
		<!-- Webview Extension API -->
		<dependency>
			<groupId>org.sokybot</groupId>
			<artifactId>sokybot-webview</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
			<groupId>org.sokybot</groupId>
			<artifactId>sokybot-runtime</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.15.2</version> 
		</dependency>
		
		<dependency>
			<groupId>org.sokybot</groupId>
			<artifactId>sokybot-proxy</artifactId>
			<version>${project.version}</version>
		</dependency>
		
		<!-- Reactor for streams -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
			<version>3.5.11</version>
		</dependency>
		
		<!-- OSGi -->
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.framework</artifactId>
			<version>1.9.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.component.annotations</artifactId>
			<version>1.5.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>org.osgi.service.event</artifactId>
			<version>1.4.1</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>


	<build>

		<plugins>

			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>

				<configuration>
					<instructions>
						<Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
						<Bundle-Name>${project.name}</Bundle-Name>
						<Bundle-Version>${project.version}</Bundle-Version>
						<Bundle-Description>${project.description}</Bundle-Description>
						<Import-Package>
							!javax.servlet*,
							!javax.swing.*,
							!java.awt.*,
							!reactor.*,
							!org.reactivestreams.*,
							*;resolution:=optional
						</Import-Package>
						<Export-Package>org.sokybot.packetsniffer</Export-Package>
					</instructions>


				</configuration>

			</plugin>
		</plugins>
	</build>

</project>