{
  "type": "div",
  "className": "h-full flex flex-col space-y-6",
  "children": [
    {
      "type": "div",
      "className": "flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2",
      "children": [
        {
          "type": "h3",
          "className": "text-slate-700 dark:text-slate-300 font-bold",
          "props": {
            "children": "Training Configuration"
          }
        },
        {
          "type": "Button",
          "variant": "outline",
          "size": "sm",
          "props": {
            "onClick": "refresh",
            "children": "Refresh"
          }
        }
      ]
    },
    {
      "type": "div",
      "className": "grid grid-cols-1 md:grid-cols-2 gap-6",
      "children": [
        {
          "type": "div",
          "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
          "children": [
            {
              "type": "h4",
              "className": "text-sm font-semibold text-emerald-600 dark:text-emerald-400 mb-3 uppercase tracking-wider",
              "props": {
                "children": "General"
              }
            },
            {
              "type": "div",
              "className": "space-y-2",
              "children": [
                {
                  "type": "div",
                  "className": "flex justify-between items-center text-sm text-slate-700 dark:text-slate-300",
                  "children": [
                    {
                      "type": "span",
                      "props": {
                        "children": "Auto Attack"
                      }
                    },
                    {
                      "type": "span",
                      "className": "${autoAttack ? 'text-green-600 dark:text-green-400' : 'text-red-500 dark:text-red-400'}",
                      "props": {
                        "children": "${autoAttack ? 'Enabled' : 'Disabled'}"
                      }
                    }
                  ]
                },
                {
                  "type": "div",
                  "className": "flex justify-between items-center text-sm text-slate-700 dark:text-slate-300",
                  "children": [
                    {
                      "type": "span",
                      "props": {
                        "children": "Auto Login"
                      }
                    },
                    {
                      "type": "span",
                      "className": "${autoLogin ? 'text-green-600 dark:text-green-400' : 'text-red-500 dark:text-red-400'}",
                      "props": {
                        "children": "${autoLogin ? 'Enabled' : 'Disabled'}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "div",
          "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
          "children": [
            {
              "type": "h4",
              "className": "text-sm font-semibold text-blue-500 dark:text-blue-400 mb-3 uppercase tracking-wider",
              "props": {
                "children": "Active Area"
              }
            },
            {
              "type": "div",
              "className": "space-y-2 text-sm",
              "props": {
                "hidden": "${activeArea === null || activeArea === undefined}",
                "children": [
                  {
                    "type": "div",
                    "className": "flex justify-between",
                    "children": [
                      {
                        "type": "span",
                        "className": "text-slate-500 dark:text-slate-400",
                        "props": {
                          "children": "Name"
                        }
                      },
                      {
                        "type": "span",
                        "className": "text-slate-900 dark:text-slate-200 font-mono",
                        "props": {
                          "children": "${activeArea.name}"
                        }
                      }
                    ]
                  },
                  {
                    "type": "div",
                    "className": "flex justify-between",
                    "children": [
                      {
                        "type": "span",
                        "className": "text-slate-500 dark:text-slate-400",
                        "props": {
                          "children": "Center (X, Y)"
                        }
                      },
                      {
                        "type": "span",
                        "className": "text-slate-900 dark:text-slate-200 font-mono",
                        "props": {
                          "children": "${activeArea.x}, ${activeArea.y}"
                        }
                      }
                    ]
                  },
                  {
                    "type": "div",
                    "className": "flex justify-between",
                    "children": [
                      {
                        "type": "span",
                        "className": "text-slate-500 dark:text-slate-400",
                        "props": {
                          "children": "Radius"
                        }
                      },
                      {
                        "type": "span",
                        "className": "text-slate-900 dark:text-slate-200 font-mono",
                        "props": {
                          "children": "${activeArea.r}"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "div",
              "className": "text-slate-500 italic text-sm",
              "props": {
                "hidden": "${activeArea !== null && activeArea !== undefined}",
                "children": "No active area set"
              }
            }
          ]
        }
      ]
    }
  ]
}
