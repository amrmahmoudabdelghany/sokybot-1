# =============================================================================
# Sokybot .gitattributes
# =============================================================================
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
# =============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# =============================================================================
# Source Code
# =============================================================================
*.java          text diff=java
*.kt            text diff=kotlin
*.scala         text diff=scala
*.groovy        text diff=groovy

# =============================================================================
# Web & Frontend
# =============================================================================
*.js            text diff=javascript
*.jsx           text diff=javascript
*.ts            text diff=typescript
*.tsx           text diff=typescript
*.css           text diff=css
*.scss          text diff=css
*.less          text diff=css
*.html          text diff=html
*.htm           text diff=html
*.vue           text
*.json          text
*.jsonc         text

# =============================================================================
# Configuration & Build
# =============================================================================
*.xml           text diff=xml
*.xsd           text diff=xml
*.xsl           text diff=xml
*.properties    text
*.yml           text
*.yaml          text
*.toml          text
*.ini           text
*.cfg           text
*.conf          text
pom.xml         text diff=xml

# =============================================================================
# Documentation
# =============================================================================
*.md            text diff=markdown
*.markdown      text diff=markdown
*.txt           text
*.rst           text
*.adoc          text
AUTHORS         text
CHANGELOG       text
CHANGES         text
CONTRIBUTING    text
COPYING         text
copyright       text
*COPYRIGHT*     text
INSTALL         text
license         text
LICENSE         text
NEWS            text
readme          text
*README*        text
TODO            text

# =============================================================================
# Scripts
# =============================================================================
*.sh            text eol=lf diff=bash
*.bash          text eol=lf diff=bash
*.zsh           text eol=lf
*.fish          text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf diff=powershell
mvnw            text eol=lf
gradlew         text eol=lf

# =============================================================================
# Binary Files (do not normalize)
# =============================================================================
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.svg           text
*.bmp           binary
*.tif           binary
*.tiff          binary

# Archives
*.zip           binary
*.tar           binary
*.tar.gz        binary
*.tgz           binary
*.gz            binary
*.7z            binary
*.rar           binary
*.jar           binary
*.war           binary
*.ear           binary
*.kar           binary

# Fonts
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.eot           binary

# Executables & Libraries
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.class         binary

# Data files
*.db            binary
*.sqlite        binary
*.pk2           binary
*.data          binary

# =============================================================================
# Git - Treat as binary (merge conflicts handled manually)
# =============================================================================
*.lock          binary
package-lock.json binary

# =============================================================================
# Linguist overrides (for GitHub language statistics)
# =============================================================================
# Exclude vendor files from language stats
sokybot-webview/src/main/frontend/node_modules/** linguist-vendored
**/node_modules/** linguist-vendored

# Mark generated files
**/generated/** linguist-generated
**/target/** linguist-generated

# Ensure certain files are detected correctly
*.tsx           linguist-language=TypeScript
*.jsx           linguist-language=JavaScript
