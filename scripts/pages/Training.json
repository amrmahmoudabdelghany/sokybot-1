{
    "type": "Stack",
    "className": "h-full space-y-6",
    "props": { "gap": 6 },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center border-b border-border pb-2",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Training Configuration"
                    }
                },
                {
                    "type": "Button",
                    "variant": "outline",
                    "size": "sm",
                    "props": {
                        "onClick": "refresh",
                        "children": "Refresh"
                    }
                }
            ]
        },
        {
            "type": "Grid",
            "props": { "cols": 1, "colsMd": 2, "gap": 6 },
            "children": [
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-emerald-500",
                            "props": { "children": "General" }
                        },
                        {
                            "type": "Stack",
                            "className": "space-y-4",
                            "props": { "gap": 4 },
                            "children": [
                                {
                                    "type": "Flex",
                                    "className": "items-center space-x-2",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.autoAttack}",
                                                "onCheckedChange": "update",
                                                "name": "autoAttack"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Enable Auto Attack"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Flex",
                                    "className": "items-center space-x-2",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.doNotAttack}",
                                                "onCheckedChange": "update",
                                                "name": "doNotAttack"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Do Not Attack Mode"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-blue-500",
                            "props": { "children": "Active Area" }
                        },
                        {
                            "type": "Stack",
                            "className": "space-y-2 text-sm",
                            "props": {
                                "gap": 2,
                                "hidden": "${activeArea === null || activeArea === undefined}"
                            },
                            "children": [
                                { "type": "KeyValue", "props": { "label": "Name", "value": "${activeArea.name}" } },
                                { "type": "KeyValue", "props": { "label": "Center (X, Y)", "value": "${activeArea.x}, ${activeArea.y}" } },
                                { "type": "KeyValue", "props": { "label": "Radius", "value": "${activeArea.radius}" } }
                            ]
                        },
                        {
                            "type": "EmptyState",
                            "className": "py-4",
                            "props": {
                                "hidden": "${activeArea !== null && activeArea !== undefined}",
                                "message": "No active area set"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
