{
    "type": "div",
    "className": "h-full flex flex-col space-y-6",
    "children": [
        {
            "type": "div",
            "className": "flex justify-between items-center border-b border-border pb-2",
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Training Configuration"
                    }
                },
                {
                    "type": "Button",
                    "variant": "outline",
                    "size": "sm",
                    "props": {
                        "onClick": "refresh",
                        "children": "Refresh"
                    }
                }
            ]
        },
        {
            "type": "div",
            "className": "grid grid-cols-1 md:grid-cols-2 gap-6",
            "children": [
                {
                    "type": "div",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "h4",
                            "className": "text-sm font-semibold text-emerald-500 mb-3 uppercase tracking-wider",
                            "props": {
                                "children": "General"
                            }
                        },
                        {
                            "type": "div",
                            "className": "space-y-4",
                            "children": [
                                {
                                    "type": "div",
                                    "className": "flex items-center space-x-2",
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.autoAttack}",
                                                "onCheckedChange": "update",
                                                "name": "autoAttack"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Enable Auto Attack"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "className": "flex items-center space-x-2",
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.doNotAttack}",
                                                "onCheckedChange": "update",
                                                "name": "doNotAttack"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Do Not Attack Mode"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "div",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "h4",
                            "className": "text-sm font-semibold text-blue-500 mb-3 uppercase tracking-wider",
                            "props": {
                                "children": "Active Area"
                            }
                        },
                        {
                            "type": "div",
                            "className": "space-y-2 text-sm",
                            "props": {
                                "hidden": "${activeArea === null || activeArea === undefined}",
                                "children": [
                                    {
                                        "type": "div",
                                        "className": "flex justify-between",
                                        "children": [
                                            {
                                                "type": "span",
                                                "className": "text-muted-foreground",
                                                "props": {
                                                    "children": "Name"
                                                }
                                            },
                                            {
                                                "type": "span",
                                                "className": "text-foreground font-mono",
                                                "props": {
                                                    "children": "${activeArea.name}"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "className": "flex justify-between",
                                        "children": [
                                            {
                                                "type": "span",
                                                "className": "text-muted-foreground",
                                                "props": {
                                                    "children": "Center (X, Y)"
                                                }
                                            },
                                            {
                                                "type": "span",
                                                "className": "text-foreground font-mono",
                                                "props": {
                                                    "children": "${activeArea.x}, ${activeArea.y}"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "div",
                                        "className": "flex justify-between",
                                        "children": [
                                            {
                                                "type": "span",
                                                "className": "text-muted-foreground",
                                                "props": {
                                                    "children": "Radius"
                                                }
                                            },
                                            {
                                                "type": "span",
                                                "className": "text-foreground font-mono",
                                                "props": {
                                                    "children": "${activeArea.radius}"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "type": "div",
                            "className": "text-muted-foreground italic text-sm",
                            "props": {
                                "hidden": "${activeArea !== null && activeArea !== undefined}",
                                "children": "No active area set"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}