{
    "type": "Stack",
    "className": "h-full space-y-6",
    "props": { "gap": 6 },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center border-b border-border pb-2",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Connection Settings"
                    }
                },
                {
                    "type": "Flex",
                    "className": "space-x-2",
                    "props": { "gap": 2 },
                    "children": [
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "refresh",
                                "children": "Refresh"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "default",
                            "size": "sm",
                            "props": {
                                "onClick": "save",
                                "children": "Save Settings"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "secondary",
                            "size": "sm",
                            "props": {
                                "onClick": "connect",
                                "children": "Connect"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "disconnect",
                                "children": "Disconnect"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": { "cols": 1, "colsMd": 2, "gap": 6 },
            "children": [
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-emerald-500",
                            "props": { "children": "Login Credentials" }
                        },
                        {
                            "type": "Stack",
                            "className": "space-y-4",
                            "props": { "gap": 4 },
                            "children": [
                                {
                                    "type": "Stack",
                                    "className": "space-y-1",
                                    "props": { "gap": 1 },
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Username"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "value": "${settings.username}",
                                                "onChange": "update",
                                                "name": "username",
                                                "placeholder": "Enter username"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-1",
                                    "props": { "gap": 1 },
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Password"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "type": "password",
                                                "value": "${settings.password}",
                                                "onChange": "update",
                                                "name": "password",
                                                "placeholder": "Enter password"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-1",
                                    "props": { "gap": 1 },
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Secondary Passcode"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "type": "password",
                                                "value": "${settings.passcode}",
                                                "onChange": "update",
                                                "name": "passcode",
                                                "placeholder": "Secondary passcode"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Stack",
                    "className": "space-y-6",
                    "props": { "gap": 6 },
                    "children": [
                        {
                            "type": "Box",
                            "className": "bg-card border border-border rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "SectionTitle",
                                    "className": "text-blue-500",
                                    "props": { "children": "Connection Config" }
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-4",
                                    "props": { "gap": 4 },
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "className": "space-y-1",
                                            "props": { "gap": 1 },
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Target Gateway"
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${settings.targetGateway}",
                                                        "onChange": "update",
                                                        "name": "targetGateway",
                                                        "placeholder": "Gateway IP"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Stack",
                                            "className": "space-y-1",
                                            "props": { "gap": 1 },
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Target Agent"
                                                    }
                                                },
                                                {
                                                    "type": "Select",
                                                    "props": {
                                                        "value": "${settings.targetAgent}",
                                                        "onChange": "update",
                                                        "name": "targetAgent",
                                                        "children": [
                                                            { "type": "option", "props": { "value": "", "children": "Select agent (or keep manual value)" } },
                                                            { "type": "option", "props": { "value": "${agentOptions[0] && agentOptions[0].value || ''}", "children": "${agentOptions[0] && agentOptions[0].label || ''}" } },
                                                            { "type": "option", "props": { "value": "${agentOptions[1] && agentOptions[1].value || ''}", "children": "${agentOptions[1] && agentOptions[1].label || ''}" } },
                                                            { "type": "option", "props": { "value": "${agentOptions[2] && agentOptions[2].value || ''}", "children": "${agentOptions[2] && agentOptions[2].label || ''}" } },
                                                            { "type": "option", "props": { "value": "${agentOptions[3] && agentOptions[3].value || ''}", "children": "${agentOptions[3] && agentOptions[3].label || ''}" } },
                                                            { "type": "option", "props": { "value": "${agentOptions[4] && agentOptions[4].value || ''}", "children": "${agentOptions[4] && agentOptions[4].label || ''}" } }
                                                        ]
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${settings.targetAgent}",
                                                        "onChange": "update",
                                                        "name": "targetAgent",
                                                        "placeholder": "Manual Agent ID"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Flex",
                                            "className": "items-center space-x-2 pt-2",
                                            "props": { "gap": 2 },
                                            "children": [
                                                {
                                                    "type": "Checkbox",
                                                    "props": {
                                                        "checked": "${settings.autoLogin}",
                                                        "onCheckedChange": "update",
                                                        "name": "autoLogin"
                                                    }
                                                },
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Enable Auto Login"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "Box",
                            "className": "bg-card border border-border rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "SectionTitle",
                                    "className": "text-purple-500",
                                    "props": { "children": "Status" }
                                },
                                {
                                    "type": "Flex",
                                    "className": "items-center space-x-2",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "Box",
                                            "className": "${connected ? 'w-3 h-3 rounded-full bg-green-500' : 'w-3 h-3 rounded-full bg-red-500'}"
                                        },
                                        { "type": "Text", "variant": "small", "props": { "children": "${connected ? 'Connected' : 'Disconnected'}" } },
                                        { "type": "Text", "variant": "small", "props": { "children": "Phase: ${loginPhase}" } }
                                    ]
                                },
                                {
                                    "type": "Box",
                                    "className": "text-xs text-muted-foreground mt-2",
                                    "props": {
                                        "children": "Agents discovered: ${agentList}"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "Box",
                            "className": "bg-card border border-border rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "SectionTitle",
                                    "className": "text-orange-500",
                                    "props": { "children": "Profiles" }
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-4",
                                    "props": { "gap": 4 },
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "className": "space-y-1",
                                            "props": { "gap": 1 },
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Profile Name"
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${profileName}",
                                                        "onChange": "update",
                                                        "name": "profileName",
                                                        "placeholder": "Enter profile name"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Flex",
                                            "className": "space-x-2",
                                            "props": { "gap": 2 },
                                            "children": [
                                                {
                                                    "type": "Button",
                                                    "variant": "outline",
                                                    "size": "sm",
                                                    "props": {
                                                        "onClick": "loadProfile",
                                                        "children": "Load"
                                                    }
                                                },
                                                {
                                                    "type": "Button",
                                                    "variant": "outline",
                                                    "size": "sm",
                                                    "props": {
                                                        "onClick": "saveProfile",
                                                        "children": "Save"
                                                    }
                                                },
                                                {
                                                    "type": "Button",
                                                    "variant": "ghost",
                                                    "size": "sm",
                                                    "className": "text-red-500 hover:text-red-600",
                                                    "props": {
                                                        "onClick": "deleteProfile",
                                                        "children": "Delete"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Box",
                                            "className": "text-xs text-muted-foreground",
                                            "props": {
                                                "children": "Available: ${profiles}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
