{
    "type": "Stack",
    "className": "h-full space-y-6",
    "props": { "gap": 6 },
    "children": [
        {
            "type": "Card",
            "children": [
                {
                    "type": "CardHeader",
                    "className": "pb-3",
                    "children": [
                        {
                            "type": "Flex",
                            "className": "items-start justify-between flex-wrap",
                            "props": { "gap": 3 },
                            "children": [
                                {
                                    "type": "Stack",
                                    "props": { "gap": 1 },
                                    "children": [
                                        { "type": "CardTitle", "props": { "children": "Connection Settings" } },
                                        {
                                            "type": "Text",
                                            "props": {
                                                "variant": "small",
                                                "children": "Configure login target and credentials, then start the bot from Machine Status."
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Flex",
                                    "className": "items-center",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "Button",
                                            "props": {
                                                "variant": "outline",
                                                "size": "sm",
                                                "onClick": "refresh",
                                                "children": "Refresh"
                                            }
                                        },
                                        {
                                            "type": "Button",
                                            "props": {
                                                "variant": "secondary",
                                                "size": "sm",
                                                "onClick": "save",
                                                "children": "Save Connection Settings"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "Alert",
            "props": {
                "hidden": "${!saveMessage}",
                "children": [
                    { "type": "AlertTitle", "props": { "children": "Saved" } },
                    {
                        "type": "AlertDescription",
                        "props": { "children": "${saveMessage}" }
                    }
                ]
            }
        },
        {
            "type": "Grid",
            "props": { "cols": 1, "colsLg": 2, "gap": 6 },
            "children": [
                {
                    "type": "Stack",
                    "props": { "gap": 6 },
                    "children": [
                        {
                            "type": "Card",
                            "children": [
                                {
                                    "type": "CardHeader",
                                    "className": "pb-2",
                                    "children": [
                                        {
                                            "type": "CardTitle",
                                            "className": "text-base",
                                            "props": { "children": "Connection Setup" }
                                        }
                                    ]
                                },
                                {
                                    "type": "CardContent",
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "props": { "gap": 4 },
                                            "children": [
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Target Gateway (IP or host)" } },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "value": "${settings.targetGateway}",
                                                                "onChange": "update",
                                                                "name": "targetGateway",
                                                                "placeholder": "e.g. 57.128.22.67 or gateway.local"
                                                            }
                                                        },
                                                        {
                                                            "type": "Text",
                                                            "props": {
                                                                "variant": "small",
                                                                "children": "Used by login-cycle once the bot is started."
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Target Agent" } },
                                                        {
                                                            "type": "Select",
                                                            "props": {
                                                                "value": "${settings.targetAgent}",
                                                                "onChange": "update",
                                                                "name": "targetAgent",
                                                                "children": [
                                                                    { "type": "option", "props": { "value": "", "children": "Select discovered agent" } },
                                                                    { "type": "option", "props": { "value": "${agentOptions[0] && agentOptions[0].value || ''}", "children": "${agentOptions[0] && agentOptions[0].label || ''}" } },
                                                                    { "type": "option", "props": { "value": "${agentOptions[1] && agentOptions[1].value || ''}", "children": "${agentOptions[1] && agentOptions[1].label || ''}" } },
                                                                    { "type": "option", "props": { "value": "${agentOptions[2] && agentOptions[2].value || ''}", "children": "${agentOptions[2] && agentOptions[2].label || ''}" } },
                                                                    { "type": "option", "props": { "value": "${agentOptions[3] && agentOptions[3].value || ''}", "children": "${agentOptions[3] && agentOptions[3].label || ''}" } },
                                                                    { "type": "option", "props": { "value": "${agentOptions[4] && agentOptions[4].value || ''}", "children": "${agentOptions[4] && agentOptions[4].label || ''}" } }
                                                                ]
                                                            }
                                                        },
                                                        {
                                                            "type": "Text",
                                                            "props": {
                                                                "variant": "small",
                                                                "children": "If your agent is not listed, enter an ID manually below."
                                                            }
                                                        },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "value": "${settings.targetAgent}",
                                                                "onChange": "update",
                                                                "name": "targetAgent",
                                                                "placeholder": "Manual Agent ID"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Flex",
                                                    "className": "items-center pt-1",
                                                    "props": { "gap": 2 },
                                                    "children": [
                                                        {
                                                            "type": "Checkbox",
                                                            "props": {
                                                                "checked": "${settings.autoLogin}",
                                                                "onCheckedChange": "update",
                                                                "name": "autoLogin"
                                                            }
                                                        },
                                                        { "type": "Label", "props": { "children": "Enable Auto Login" } }
                                                    ]
                                                },
                                                {
                                                    "type": "Card",
                                                    "children": [
                                                        {
                                                            "type": "CardHeader",
                                                            "className": "pb-2 pt-3",
                                                            "children": [
                                                                {
                                                                    "type": "CardTitle",
                                                                    "className": "text-sm",
                                                                    "props": { "children": "Reconnect Policy" }
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "type": "CardContent",
                                                            "children": [
                                                                {
                                                                    "type": "Stack",
                                                                    "props": { "gap": 3 },
                                                                    "children": [
                                                                        {
                                                                            "type": "Flex",
                                                                            "className": "items-center",
                                                                            "props": { "gap": 2 },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Checkbox",
                                                                                    "props": {
                                                                                        "checked": "${settings.autoReconnect}",
                                                                                        "onCheckedChange": "update",
                                                                                        "name": "autoReconnect"
                                                                                    }
                                                                                },
                                                                                { "type": "Label", "props": { "children": "Enable Auto Reconnect" } }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "Flex",
                                                                            "className": "items-center",
                                                                            "props": { "gap": 2 },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Checkbox",
                                                                                    "props": {
                                                                                        "checked": "${settings.infiniteRetryMode}",
                                                                                        "onCheckedChange": "update",
                                                                                        "name": "infiniteRetryMode"
                                                                                    }
                                                                                },
                                                                                { "type": "Label", "props": { "children": "Infinite Retry Mode" } }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "Stack",
                                                                            "props": { "gap": 1 },
                                                                            "children": [
                                                                                { "type": "Label", "props": { "children": "Base Retry Delay (ms)" } },
                                                                                {
                                                                                    "type": "Input",
                                                                                    "props": {
                                                                                        "value": "${settings.retryBaseDelayMs}",
                                                                                        "onChange": "update",
                                                                                        "name": "retryBaseDelayMs",
                                                                                        "placeholder": "5000"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "Stack",
                                                                            "props": { "gap": 1 },
                                                                            "children": [
                                                                                { "type": "Label", "props": { "children": "Max Retry Delay (ms)" } },
                                                                                {
                                                                                    "type": "Input",
                                                                                    "props": {
                                                                                        "value": "${settings.retryMaxDelayMs}",
                                                                                        "onChange": "update",
                                                                                        "name": "retryMaxDelayMs",
                                                                                        "placeholder": "60000"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "Stack",
                                                                            "props": { "gap": 1 },
                                                                            "children": [
                                                                                { "type": "Label", "props": { "children": "Max Retry Attempts (0 = unlimited)" } },
                                                                                {
                                                                                    "type": "Input",
                                                                                    "props": {
                                                                                        "value": "${settings.maxRetryAttempts}",
                                                                                        "onChange": "update",
                                                                                        "name": "maxRetryAttempts",
                                                                                        "placeholder": "0"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "Card",
                            "children": [
                                {
                                    "type": "CardHeader",
                                    "className": "pb-2",
                                    "children": [
                                        {
                                            "type": "CardTitle",
                                            "className": "text-base",
                                            "props": { "children": "Credentials" }
                                        }
                                    ]
                                },
                                {
                                    "type": "CardContent",
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "props": { "gap": 4 },
                                            "children": [
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Username" } },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "value": "${settings.username}",
                                                                "onChange": "update",
                                                                "name": "username",
                                                                "placeholder": "Enter username"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Password" } },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "type": "password",
                                                                "value": "${settings.password}",
                                                                "onChange": "update",
                                                                "name": "password",
                                                                "placeholder": "Enter password"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Secondary Passcode" } },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "type": "password",
                                                                "value": "${settings.passcode}",
                                                                "onChange": "update",
                                                                "name": "passcode",
                                                                "placeholder": "Optional passcode"
                                                            }
                                                        },
                                                        {
                                                            "type": "Text",
                                                            "props": {
                                                                "variant": "small",
                                                                "children": "Stored via your secure credential encryptor."
                                                            }
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Stack",
                    "props": { "gap": 6 },
                    "children": [
                        {
                            "type": "Card",
                            "children": [
                                {
                                    "type": "CardHeader",
                                    "className": "pb-2",
                                    "children": [
                                        {
                                            "type": "CardTitle",
                                            "className": "text-base",
                                            "props": { "children": "Profiles" }
                                        }
                                    ]
                                },
                                {
                                    "type": "CardContent",
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "props": { "gap": 4 },
                                            "children": [
                                                {
                                                    "type": "Stack",
                                                    "props": { "gap": 1 },
                                                    "children": [
                                                        { "type": "Label", "props": { "children": "Profile Name" } },
                                                        {
                                                            "type": "Input",
                                                            "props": {
                                                                "value": "${profileName}",
                                                                "onChange": "update",
                                                                "name": "profileName",
                                                                "placeholder": "Enter profile name"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Flex",
                                                    "className": "items-center flex-wrap",
                                                    "props": { "gap": 2 },
                                                    "children": [
                                                        {
                                                            "type": "Button",
                                                            "props": {
                                                                "variant": "outline",
                                                                "size": "sm",
                                                                "onClick": "loadProfile",
                                                                "disabled": "${!profileName}",
                                                                "children": "Load"
                                                            }
                                                        },
                                                        {
                                                            "type": "Button",
                                                            "props": {
                                                                "variant": "outline",
                                                                "size": "sm",
                                                                "onClick": "saveProfile",
                                                                "disabled": "${!profileName}",
                                                                "children": "Save"
                                                            }
                                                        },
                                                        {
                                                            "type": "Dialog",
                                                            "children": [
                                                                {
                                                                    "type": "DialogTrigger",
                                                                    "props": { "asChild": true },
                                                                    "children": [
                                                                        {
                                                                            "type": "Button",
                                                                            "props": {
                                                                                "variant": "destructive",
                                                                                "size": "sm",
                                                                                "disabled": "${!profileName}",
                                                                                "children": "Delete"
                                                                            }
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "DialogContent",
                                                                    "children": [
                                                                        { "type": "DialogTitle", "props": { "children": "Delete profile?" } },
                                                                        {
                                                                            "type": "DialogDescription",
                                                                            "props": {
                                                                                "children": "This removes profile ${profileName}. This action cannot be undone."
                                                                            }
                                                                        },
                                                                        {
                                                                            "type": "Flex",
                                                                            "className": "justify-end pt-2",
                                                                            "props": { "gap": 2 },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Button",
                                                                                    "props": {
                                                                                        "variant": "destructive",
                                                                                        "size": "sm",
                                                                                        "onClick": "deleteProfile",
                                                                                        "children": "Confirm Delete"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "variant": "small",
                                                        "hidden": "${(profiles.length || 0) > 0}",
                                                        "children": "No saved profiles yet."
                                                    }
                                                },
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "variant": "small",
                                                        "children": "Available profiles: ${profiles}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
