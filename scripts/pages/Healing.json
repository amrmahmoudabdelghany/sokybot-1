{
    "type": "Stack",
    "className": "h-full space-y-6",
    "props": { "gap": 6 },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center border-b border-border pb-2",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Healing Settings"
                    }
                },
                {
                    "type": "Flex",
                    "className": "space-x-2",
                    "props": { "gap": 2 },
                    "children": [
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "refresh",
                                "children": "Refresh"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "default",
                            "size": "sm",
                            "props": {
                                "onClick": "save",
                                "children": "Save Settings"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": { "cols": 1, "colsMd": 2, "gap": 6 },
            "children": [
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-rose-500",
                            "props": { "children": "Character Healing" }
                        },
                        {
                            "type": "Stack",
                            "className": "space-y-6",
                            "props": { "gap": 6 },
                            "children": [
                                {
                                    "type": "Stack",
                                    "className": "space-y-3",
                                    "props": { "gap": 3 },
                                    "children": [
                                        { "type": "KeyValue", "props": { "label": "HP Potion Threshold", "value": "${settings.hpPotionThreshold}%" } },
                                        {
                                            "type": "Slider",
                                            "props": {
                                                "value": [
                                                    "${settings.hpPotionThreshold}"
                                                ],
                                                "min": 0,
                                                "max": 100,
                                                "step": 1,
                                                "onValueChange": "update",
                                                "name": "hpPotionThreshold"
                                            }
                                        },
                                        {
                                            "type": "Flex",
                                            "className": "items-center space-x-2",
                                            "props": { "gap": 2 },
                                            "children": [
                                                {
                                                    "type": "Checkbox",
                                                    "props": {
                                                        "checked": "${settings.useHpPotion}",
                                                        "onCheckedChange": "update",
                                                        "name": "useHpPotion"
                                                    }
                                                },
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Use HP Potions"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-3",
                                    "props": { "gap": 3 },
                                    "children": [
                                        { "type": "KeyValue", "props": { "label": "MP Potion Threshold", "value": "${settings.mpPotionThreshold}%" } },
                                        {
                                            "type": "Slider",
                                            "props": {
                                                "value": [
                                                    "${settings.mpPotionThreshold}"
                                                ],
                                                "min": 0,
                                                "max": 100,
                                                "step": 1,
                                                "onValueChange": "update",
                                                "name": "mpPotionThreshold"
                                            }
                                        },
                                        {
                                            "type": "Flex",
                                            "className": "items-center space-x-2",
                                            "props": { "gap": 2 },
                                            "children": [
                                                {
                                                    "type": "Checkbox",
                                                    "props": {
                                                        "checked": "${settings.useMpPotion}",
                                                        "onCheckedChange": "update",
                                                        "name": "useMpPotion"
                                                    }
                                                },
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Use MP Potions"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Stack",
                    "className": "space-y-6",
                    "props": { "gap": 6 },
                    "children": [
                        {
                            "type": "Box",
                            "className": "bg-card border border-border rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "SectionTitle",
                                    "className": "text-purple-500",
                                    "props": { "children": "Live Status" }
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-4",
                                    "props": { "gap": 4 },
                                    "children": [
                                        {
                                            "type": "Stack",
                                            "className": "space-y-1",
                                            "props": { "gap": 1 },
                                            "children": [
                                                {
                                                    "type": "Flex",
                                                    "className": "justify-between text-sm",
                                                    "props": { "gap": 2 },
                                                    "children": [
                                                        {
                                                            "type": "span",
                                                            "props": {
                                                                "children": "HP"
                                                            }
                                                        },
                                                        {
                                                            "type": "span",
                                                            "props": {
                                                                "children": "${currentHP} / ${maxHP}"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Progress",
                                                    "props": {
                                                        "value": "${(currentHP / maxHP) * 100}",
                                                        "className": "h-2 bg-secondary",
                                                        "indicatorClassName": "bg-red-500"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "Stack",
                                            "className": "space-y-1",
                                            "props": { "gap": 1 },
                                            "children": [
                                                {
                                                    "type": "Flex",
                                                    "className": "justify-between text-sm",
                                                    "props": { "gap": 2 },
                                                    "children": [
                                                        {
                                                            "type": "span",
                                                            "props": {
                                                                "children": "MP"
                                                            }
                                                        },
                                                        {
                                                            "type": "span",
                                                            "props": {
                                                                "children": "${currentMP} / ${maxMP}"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "Progress",
                                                    "props": {
                                                        "value": "${(currentMP / maxMP) * 100}",
                                                        "className": "h-2 bg-secondary",
                                                        "indicatorClassName": "bg-blue-500"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
