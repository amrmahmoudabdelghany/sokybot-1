{
  "type": "Stack",
  "className": "h-full",
  "props": { "gap": 0 },
  "children": [
    {
      "type": "Flex",
      "className": "items-center justify-between p-2 border-b border-border",
      "props": { "gap": 4 },
      "children": [
        {
          "type": "Flex",
          "className": "items-center gap-4",
          "props": { "gap": 4 },
          "children": [
            {
              "type": "span",
              "className": "text-sm",
              "props": {
                "children": "Selected: ${selectedByteCount} byte(s)"
              }
            },
            {
              "type": "span",
              "className": "text-sm",
              "props": {
                "children": "Matches: ${matchCount}"
              }
            }
          ]
        },
        {
          "type": "Button",
          "variant": "outline",
          "size": "sm",
          "props": {
            "onClick": "closeAnalyzer",
            "children": "Close"
          }
        }
      ]
    },
    {
      "type": "hex-viewer",
      "className": "flex-1",
      "props": {
        "dataSource": "packets",
        "onSelectHex": "selectHex",
        "onDefineVariable": "defineVariable"
      }
    },
    {
      "type": "Box",
      "className": "border-t border-border",
      "children": [
        {
          "type": "table",
          "className": "h-[200px]",
          "props": {
            "dataSource": "variables",
            "columns": [
              {
                "field": "packet",
                "label": "Packet",
                "className": "w-[150px]"
              },
              {
                "field": "varName",
                "label": "Var",
                "className": "w-[150px]",
                "editable": true
              },
              {
                "field": "value",
                "label": "Value",
                "className": "w-[120px]"
              },
              {
                "field": "comment",
                "label": "Comment",
                "className": "flex-1",
                "editable": true
              }
            ],
            "onRowClick": "selectVariable",
            "onCellEdit": "updateVariable"
          }
        }
      ]
    }
  ]
}
