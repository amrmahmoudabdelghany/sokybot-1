{
    "type": "Stack",
    "className": "h-full space-y-6",
    "props": { "gap": 6 },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center border-b border-border pb-2",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Navigation & Loop"
                    }
                },
                {
                    "type": "Flex",
                    "className": "space-x-2",
                    "props": { "gap": 2 },
                    "children": [
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "refresh",
                                "children": "Refresh"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "default",
                            "size": "sm",
                            "props": {
                                "onClick": "save",
                                "children": "Save Settings"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": { "cols": 1, "colsMd": 2, "gap": 6 },
            "children": [
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-amber-500",
                            "props": { "children": "Town Loop" }
                        },
                        {
                            "type": "Stack",
                            "className": "space-y-4",
                            "props": { "gap": 4 },
                            "children": [
                                {
                                    "type": "Flex",
                                    "className": "items-center space-x-2",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.loopInTown}",
                                                "onCheckedChange": "update",
                                                "name": "loopInTown"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Enable Town Loop"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Stack",
                                    "className": "space-y-1",
                                    "props": { "gap": 1 },
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Script Path"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "value": "${settings.scriptPath}",
                                                "onChange": "update",
                                                "name": "scriptPath",
                                                "placeholder": "Path to training area script"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Box",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "SectionTitle",
                            "className": "text-blue-500",
                            "props": { "children": "Current Position" }
                        },
                        {
                            "type": "Grid",
                            "className": "text-center",
                            "props": { "cols": 2, "gap": 4 },
                            "children": [
                                {
                                    "type": "Box",
                                    "className": "p-3 bg-muted rounded",
                                    "children": [
                                        {
                                            "type": "Text",
                                            "className": "uppercase",
                                            "variant": "small",
                                            "props": { "children": "X Coordinate" }
                                        },
                                        {
                                            "type": "Text",
                                            "className": "text-lg font-mono font-bold text-foreground",
                                            "props": { "children": "${position.x}" }
                                        }
                                    ]
                                },
                                {
                                    "type": "Box",
                                    "className": "p-3 bg-muted rounded",
                                    "children": [
                                        {
                                            "type": "Text",
                                            "className": "uppercase",
                                            "variant": "small",
                                            "props": { "children": "Y Coordinate" }
                                        },
                                        {
                                            "type": "Text",
                                            "className": "text-lg font-mono font-bold text-foreground",
                                            "props": { "children": "${position.y}" }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
