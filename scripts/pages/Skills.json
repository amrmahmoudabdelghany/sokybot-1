{
    "type": "Stack",
    "className": "h-full space-y-4",
    "props": { "gap": 4 },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Skills (${skills.length}) - Points: ${skillPoints}"
                    }
                },
                {
                    "type": "Button",
                    "variant": "outline",
                    "size": "sm",
                    "props": {
                        "onClick": "refresh",
                        "children": "Refresh"
                    }
                }
            ]
        },
        {
            "type": "div",
            "className": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2",
            "props": {
                "dataSource": "skills",
                "renderItem": {
                    "type": "Flex",
                    "className": "bg-card border border-border p-2 rounded items-center space-x-3 hover:border-primary/50 transition-colors shadow-sm",
                    "props": { "gap": 3 },
                    "children": [
                        {
                            "type": "Box",
                            "className": "w-8 h-8 rounded bg-secondary flex items-center justify-center text-xs text-muted-foreground",
                            "props": {
                                "children": "SK"
                            }
                        },
                        {
                            "type": "Box",
                            "className": "flex-1 overflow-hidden",
                            "children": [
                                {
                                    "type": "Box",
                                    "className": "text-sm font-medium text-foreground truncate",
                                    "props": {
                                        "title": "${item.name}",
                                        "children": "${item.name}"
                                    }
                                },
                                {
                                    "type": "Flex",
                                    "className": "text-xs text-muted-foreground justify-between",
                                    "props": { "gap": 2 },
                                    "children": [
                                        {
                                            "type": "span",
                                            "props": {
                                                "children": "Lv.${item.level}"
                                            }
                                        },
                                        {
                                            "type": "span",
                                            "className": "${item.enabled ? 'text-green-500' : 'text-muted-foreground'}",
                                            "props": {
                                                "children": "${item.enabled ? 'Active' : 'Disabled'}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        },
        {
            "type": "EmptyState",
            "props": {
                "hidden": "${skills.length > 0}",
                "message": "No skills learnt",
                "icon": "BookOpen",
                "action": "refresh",
                "actionLabel": "Refresh"
            }
        }
    ]
}
