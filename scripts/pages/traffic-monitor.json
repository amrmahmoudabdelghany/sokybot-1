{
  "type": "stream-table-panel",
  "className": "w-full h-full",
  "stream": {
    "streamId": "packets",
    "stateKey": "trafficPackets",
    "mode": "append",
    "streamParams": {
      "includeHistory": true
    },
    "maxCapacity": 1000,
    "maxQueueSize": 2000,
    "rowKey": "index",
    "orphanDeltaPolicy": "ignore",
    "pauseQueuePolicy": "bufferBounded",
    "flushWhilePaused": "applyImmediately",
    "control": {
      "flushSignalType": "FLUSH",
      "snapshotSignalType": "SNAPSHOT",
      "deleteField": "_delete"
    }
  },
  "props": {
    "title": "Traffic Monitor",
    "filterKey": "monitorFilterQuery",
    "filterAction": "filterMonitor",
    "table": {
      "columns": [
        {
          "field": "time",
          "label": "Time",
          "className": "text-left p-2 border whitespace-nowrap font-mono text-xs text-foreground/90"
        },
        {
          "field": "source",
          "label": "Source",
          "className": "text-left p-2 border whitespace-nowrap"
        },
        {
          "field": "encoding",
          "label": "Encoding",
          "className": "text-left p-2 border whitespace-nowrap"
        },
        {
          "field": "size",
          "label": "Size",
          "className": "text-right p-2 border whitespace-nowrap"
        },
        {
          "field": "name",
          "label": "Name",
          "className": "text-left p-2 border whitespace-nowrap"
        },
        {
          "field": "opcode",
          "label": "Opcode",
          "className": "text-left p-2 border font-mono whitespace-nowrap"
        },
        {
          "field": "count",
          "label": "Count",
          "className": "text-left p-2 border font-mono whitespace-nowrap"
        },
        {
          "field": "crc",
          "label": "CRC",
          "className": "text-left p-2 border font-mono whitespace-nowrap"
        },
        {
          "field": "payload",
          "label": "Payload",
          "className": "text-left p-2 border font-mono text-xs",
          "title": "payload",
          "maxWidth": 220,
          "truncate": true
        }
      ],
      "rowKey": "index",
      "multiSelectAction": "selectPackets",
      "autoScroll": "${trafficAutoScroll !== false}",
      "expandable": true,
      "rowConditionalStyle": {
        "field": "source",
        "values": {
          "SERVER": {
            "borderLeft": "3px solid rgb(249 115 22 / 0.8)",
            "backgroundColor": "rgba(249, 115, 22, 0.06)"
          },
          "CLIENT": {
            "borderLeft": "3px solid rgb(56 189 248 / 0.8)",
            "backgroundColor": "rgba(56, 189, 248, 0.06)"
          },
          "BOT": {
            "borderLeft": "3px solid rgb(139 92 246 / 0.8)",
            "backgroundColor": "rgba(139, 92, 246, 0.06)"
          }
        }
      },
      "rowActions": [
        {
          "label": "Analyze",
          "action": "openAnalyzer",
          "title": "Open packet analyzer for this packet"
        },
        {
          "label": "↻",
          "action": "openReplay",
          "title": "Replay Packet"
        },
        {
          "label": "</>",
          "action": "copyAsCode",
          "title": "Copy send snippet (Groovy)"
        },
        {
          "label": "Hex",
          "action": "copyHex",
          "title": "Copy Hex Payload"
        },
        {
          "label": "JSON",
          "action": "copyJson",
          "title": "Copy as JSON"
        }
      ],
      "rowClassName": "hover:bg-muted/50 cursor-pointer transition-colors"
    }
  }
}