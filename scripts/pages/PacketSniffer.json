{
  "type": "layout",
  "layout": "column",
  "gap": 4,
  "className": "p-6 h-full",
  "children": [
    {
      "type": "Flex",
      "className": "border-b border-border space-x-1",
      "props": { "gap": 1 },
      "children": [
        {
          "type": "Button",
          "variant": "ghost",
          "className": "rounded-t-lg data-[active=true]:bg-muted data-[active=true]:border-t data-[active=true]:border-l data-[active=true]:border-r data-[active=true]:border-b-0 border-transparent",
          "props": {
            "onClick": "switchTab",
            "actionData": { "tab": "traffic" },
            "data-active": "${activeTab === 'traffic'}",
            "children": "Traffic Monitor"
          }
        },
        {
          "type": "Button",
          "variant": "ghost",
          "className": "rounded-t-lg data-[active=true]:bg-muted data-[active=true]:border-t data-[active=true]:border-l data-[active=true]:border-r data-[active=true]:border-b-0 border-transparent",
          "props": {
            "onClick": "switchTab",
            "actionData": { "tab": "tracer" },
            "data-active": "${activeTab === 'tracer'}",
            "children": "Packet Tracer"
          }
        }
      ]
    },
    {
      "type": "Box",
      "className": "flex-1 overflow-auto",
      "props": { "id": "tabContent" },
      "children": [
        {
          "type": "Box",
          "props": { "id": "trafficContent", "hidden": "${activeTab !== 'traffic'}" },
          "children": [{ "$ref": "traffic-monitor.json" }]
        },
        {
          "type": "Box",
          "props": { "id": "tracerContent", "hidden": "${activeTab !== 'tracer'}" },
          "children": [{ "$ref": "packet-tracer.json" }]
        }
      ]
    },
    {
      "type": "Dialog",
      "props": {
        "open": "${analyzerOpen}",
        "onOpenChange": "closeAnalyzer"
      },
      "children": [
        {
          "type": "DialogContent",
          "className": "max-w-5xl h-[90vh] max-h-[90vh] flex flex-col overflow-hidden bg-background text-foreground",
          "children": [
            {
              "type": "DialogHeader",
              "children": [
                {
                  "type": "DialogTitle",
                  "props": { "children": "Packet Analyzer" }
                }
              ]
            },
            {
              "type": "Flex",
              "className": "items-center justify-between p-2 border-b border-border",
              "props": { "gap": 4 },
              "children": [
                {
                  "type": "Flex",
                  "className": "items-center gap-4",
                  "props": { "gap": 4 },
                  "children": [
                    { "type": "span", "className": "text-sm", "props": { "children": "Selected: ${selectedByteCount} byte(s)" } },
                    { "type": "span", "className": "text-sm", "props": { "children": "Matches: ${matchCount}" } }
                  ]
                },
                {
                  "type": "Button",
                  "variant": "outline",
                  "size": "sm",
                  "props": { "onClick": "closeAnalyzer", "children": "Close" }
                }
              ]
            },
            {
              "type": "hex-viewer",
              "className": "flex-1 min-h-[240px] overflow-auto",
              "props": {
                "dataSource": "packets",
                "onSelectHex": "selectHex",
                "onDefineVariable": "defineVariable"
              }
            },
            {
              "type": "Box",
              "className": "border-t border-border flex-shrink-0",
              "children": [
                {
                  "type": "table",
                  "className": "h-[200px]",
                  "props": {
                    "dataSource": "variables",
                    "columns": [
                      { "field": "packet", "label": "Packet", "className": "w-[150px]" },
                      { "field": "varName", "label": "Var", "className": "w-[150px]" },
                      { "field": "value", "label": "Value", "className": "w-[120px]" },
                      { "field": "comment", "label": "Comment", "className": "flex-1" }
                    ],
                    "onRowClick": "selectVariable"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
