{
    "type": "Stack",
    "className": "w-full h-full flex flex-col",
    "props": {
        "gap": 0,
        "streamId": "Log",
        "stateKey": "Log",
        "streamParams": {
            "level": "${Log.level}",
            "feature": "${Log.feature}",
            "maxEntries": "${Log.maxEvents}"
        }
    },
    "children": [
        {
            "type": "Flex",
            "className": "justify-between items-center mb-2",
            "props": { "gap": 2 },
            "children": [
                {
                    "type": "Flex",
                    "className": "items-center gap-2",
                    "props": { "gap": 2 },
                    "children": [
                        {
                            "type": "h3",
                            "className": "text-sm font-bold text-foreground",
                            "props": {
                                "children": "Event Log"
                            }
                        },
                        {
                            "type": "span",
                            "className": "text-xs text-muted-foreground",
                            "props": {
                                "children": "Last ${ (Log && Log.maxEvents) || 0 } events"
                            }
                        }
                    ]
                },
                {
                    "type": "Flex",
                    "className": "items-center gap-2",
                    "props": { "gap": 2 },
                    "children": [
                        {
                            "type": "Select",
                            "className": "h-7 px-2 text-[11px]",
                            "props": {
                                "value": "${Log && Log.level || 'ALL'}",
                                "onChange": "setLogLevel",
                                "children": [
                                    { "type": "option", "props": { "value": "ALL", "children": "All" } },
                                    { "type": "option", "props": { "value": "ERROR", "children": "Error" } },
                                    { "type": "option", "props": { "value": "WARN", "children": "Warn" } },
                                    { "type": "option", "props": { "value": "INFO", "children": "Info" } },
                                    { "type": "option", "props": { "value": "DEBUG", "children": "Debug" } },
                                    { "type": "option", "props": { "value": "TRACE", "children": "Trace" } }
                                ]
                            }
                        },
                        {
                            "type": "Select",
                            "className": "h-7 px-2 text-[11px]",
                            "props": {
                                "value": "${Log && Log.feature || 'ALL'}",
                                "onChange": "setLogFeature",
                                "children": [
                                    { "type": "option", "props": { "value": "ALL", "children": "All features" } },
                                    { "type": "option", "props": { "value": "training", "children": "Training" } },
                                    { "type": "option", "props": { "value": "healing", "children": "Healing" } },
                                    { "type": "option", "props": { "value": "connection", "children": "Connection" } },
                                    { "type": "option", "props": { "value": "navigation", "children": "Navigation" } },
                                    { "type": "option", "props": { "value": "inventory", "children": "Inventory" } },
                                    { "type": "option", "props": { "value": "skills", "children": "Skills" } }
                                ]
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "clearLog",
                                "children": "Clear"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "log-viewer",
            "className": "flex-1 min-h-0",
            "props": {
                "dataSource": "Log && Log.events ? Log.events : []"
            }
        }
    ]
}
