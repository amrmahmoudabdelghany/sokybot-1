node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnpm-debug.log*

# Build outputs
dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# =============================================================================
# Security - Never commit these!
# =============================================================================
*.pem
*.key
*.p12
*.jks
*.keystore
*.truststore
credentials.json
secrets.json
*.secret
.env.production

# =============================================================================
# OWASP Dependency Check
# =============================================================================
dependency-check-report.*
.dependency-check/

# =============================================================================
# Temporary Files
# =============================================================================
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

