{
    "type": "div",
    "className": "space-y-4",
    "children": [
        {
            "type": "div",
            "className": "flex justify-between items-center",
            "children": [
                {
                    "type": "h4",
                    "className": "font-medium",
                    "props": {
                        "children": "Installed Bundles"
                    }
                },
                {
                    "type": "Button",
                    "variant": "outline",
                    "size": "sm",
                    "props": {
                        "onClick": "refresh",
                        "children": "Refresh"
                    }
                }
            ]
        },
        {
            "type": "div",
            "className": "text-sm text-muted-foreground",
            "props": {
                "dataSource": "bundles",
                "children": "${bundles.length} bundles installed"
            }
        }
    ]
}