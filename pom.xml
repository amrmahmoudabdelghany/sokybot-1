		<project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Desktop Packaging -->
		<maven.assembly.version>3.6.0</maven.assembly.version>
		<jre.version>21</jre.version>
		<app.name>Sokybot</app.name>
		<app.main.class>org.apache.karaf.main.Main</app.main.class>

		<!-- Reactor -->
		<reactor-bom.version>2023.0.0</reactor-bom.version>

		<!-- Shared Infrastructure Versions (used by Karaf features) -->
		<netty.version>4.1.100.Final</netty.version>
		<reactor.version>3.6.0</reactor.version>
		<reactor-netty.version>1.1.13</reactor-netty.version>
		<reactive-streams.version>1.0.4</reactive-streams.version>
		<rsocket.version>1.1.4</rsocket.version>
	</properties>


    <modules>
        <module>core</module>
        <module>network</module>
        <module>game</module>
        <module>ui</module>
        <module>infra</module>
    </modules>
	<packaging>pom</packaging>


