/sokybot-pk2-extractor/             @sokybot/game-data-team
/sokybot-game-loader/               @sokybot/game-data-team
/sokybot-game-model/                @sokybot/game-data-team
/sokybot-game-asset/                @sokybot/game-data-team
/sokybot-game-events/               @sokybot/game-data-team
/sokybot-game-navigation/           @sokybot/game-data-team

# =============================================================================
# UI & Frontend
# =============================================================================
/sokybot-webview/                   @sokybot/frontend-team
/sokybot-swing/                     @sokybot/frontend-team
/sokybot-dev-tools/                 @sokybot/frontend-team
