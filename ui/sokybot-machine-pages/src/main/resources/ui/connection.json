{
    "type": "div",
    "className": "h-full flex flex-col space-y-6",
    "children": [
        {
            "type": "div",
            "className": "flex justify-between items-center border-b border-slate-200 dark:border-slate-800 pb-2",
            "children": [
                {
                    "type": "h3",
                    "className": "text-slate-700 dark:text-slate-300 font-bold",
                    "props": {
                        "children": "Connection Settings"
                    }
                },
                {
                    "type": "div",
                    "className": "flex space-x-2",
                    "children": [
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "refresh",
                                "children": "Refresh"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "default",
                            "size": "sm",
                            "props": {
                                "onClick": "save",
                                "children": "Save Settings"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "div",
            "className": "grid grid-cols-1 md:grid-cols-2 gap-6",
            "children": [
                {
                    "type": "div",
                    "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "h4",
                            "className": "text-sm font-semibold text-emerald-600 dark:text-emerald-400 mb-3 uppercase tracking-wider",
                            "props": {
                                "children": "Login Credentials"
                            }
                        },
                        {
                            "type": "div",
                            "className": "space-y-4",
                            "children": [
                                {
                                    "type": "div",
                                    "className": "space-y-1",
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Username"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "value": "${settings.username}",
                                                "onChange": "update",
                                                "name": "username",
                                                "placeholder": "Enter username"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "className": "space-y-1",
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Password"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "type": "password",
                                                "value": "${settings.password}",
                                                "onChange": "update",
                                                "name": "password",
                                                "placeholder": "Enter password"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "className": "space-y-1",
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Secondary Passcode"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "type": "password",
                                                "value": "${settings.passcode}",
                                                "onChange": "update",
                                                "name": "passcode",
                                                "placeholder": "Secondary passcode"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "div",
                    "className": "space-y-6",
                    "children": [
                        {
                            "type": "div",
                            "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "h4",
                                    "className": "text-sm font-semibold text-blue-500 dark:text-blue-400 mb-3 uppercase tracking-wider",
                                    "props": {
                                        "children": "Connection Config"
                                    }
                                },
                                {
                                    "type": "div",
                                    "className": "space-y-4",
                                    "children": [
                                        {
                                            "type": "div",
                                            "className": "space-y-1",
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Target Gateway"
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${settings.targetGateway}",
                                                        "onChange": "update",
                                                        "name": "targetGateway",
                                                        "placeholder": "Gateway IP"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "div",
                                            "className": "space-y-1",
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Target Agent"
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${settings.targetAgent}",
                                                        "onChange": "update",
                                                        "name": "targetAgent",
                                                        "placeholder": "Agent ID"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "div",
                                            "className": "flex items-center space-x-2 pt-2",
                                            "children": [
                                                {
                                                    "type": "Checkbox",
                                                    "props": {
                                                        "checked": "${settings.autoLogin}",
                                                        "onCheckedChange": "update",
                                                        "name": "autoLogin"
                                                    }
                                                },
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Enable Auto Login"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "div",
                            "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "h4",
                                    "className": "text-sm font-semibold text-purple-500 dark:text-purple-400 mb-3 uppercase tracking-wider",
                                    "props": {
                                        "children": "Status"
                                    }
                                },
                                {
                                    "type": "div",
                                    "className": "flex items-center space-x-2",
                                    "children": [
                                        {
                                            "type": "div",
                                            "className": "${connected ? 'w-3 h-3 rounded-full bg-green-500' : 'w-3 h-3 rounded-full bg-red-500'}"
                                        },
                                        {
                                            "type": "span",
                                            "className": "text-sm",
                                            "props": {
                                                "children": "${connected ? 'Connected' : 'Disconnected'}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "div",
                            "className": "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-4 shadow-sm",
                            "children": [
                                {
                                    "type": "h4",
                                    "className": "text-sm font-semibold text-orange-500 dark:text-orange-400 mb-3 uppercase tracking-wider",
                                    "props": {
                                        "children": "Profiles"
                                    }
                                },
                                {
                                    "type": "div",
                                    "className": "space-y-4",
                                    "children": [
                                        {
                                            "type": "div",
                                            "className": "space-y-1",
                                            "children": [
                                                {
                                                    "type": "Label",
                                                    "props": {
                                                        "children": "Profile Name"
                                                    }
                                                },
                                                {
                                                    "type": "Input",
                                                    "props": {
                                                        "value": "${profileName}",
                                                        "onChange": "update",
                                                        "name": "profileName",
                                                        "placeholder": "Enter profile name"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "div",
                                            "className": "flex space-x-2",
                                            "children": [
                                                {
                                                    "type": "Button",
                                                    "variant": "outline",
                                                    "size": "sm",
                                                    "props": {
                                                        "onClick": "loadProfile",
                                                        "children": "Load"
                                                    }
                                                },
                                                {
                                                    "type": "Button",
                                                    "variant": "outline",
                                                    "size": "sm",
                                                    "props": {
                                                        "onClick": "saveProfile",
                                                        "children": "Save"
                                                    }
                                                },
                                                {
                                                    "type": "Button",
                                                    "variant": "ghost",
                                                    "size": "sm",
                                                    "className": "text-red-500 hover:text-red-600",
                                                    "props": {
                                                        "onClick": "deleteProfile",
                                                        "children": "Delete"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "div",
                                            "className": "text-xs text-slate-500",
                                            "props": {
                                                "children": "Available: ${profiles}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}