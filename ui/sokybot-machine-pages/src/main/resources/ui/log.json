{
  "type": "div",
  "className": "w-full h-full flex flex-col",
  "children": [
    {
      "type": "div",
      "className": "flex justify-between items-center mb-2",
      "children": [
        {
          "type": "h3",
          "className": "text-sm font-bold text-slate-700 dark:text-slate-300",
          "props": {
            "children": "Event Log"
          }
        },
        {
          "type": "div",
          "className": "flex items-center gap-2",
          "children": [
            {
              "type": "span",
              "className": "text-xs text-slate-500",
              "props": {
                "children": "Last ${maxEvents} events"
              }
            },
            {
              "type": "Button",
              "variant": "outline",
              "size": "sm",
              "props": {
                "onClick": "clearLog",
                "children": "Clear"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "div",
      "className": "bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 p-2 rounded h-96 overflow-y-auto font-mono text-xs shadow-inner",
      "children": [
        {
          "type": "div",
          "className": "text-slate-400 dark:text-gray-600 text-center italic mt-10",
          "props": {
            "hidden": "${events.length > 0}",
            "children": "Waiting for events..."
          }
        },
        {
          "type": "div",
          "props": {
            "dataSource": "events",
            "renderItem": {
              "type": "div",
              "className": "border-b border-slate-100 dark:border-slate-800 py-1 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors",
              "children": [
                {
                  "type": "div",
                  "className": "flex items-center gap-2 mb-0.5",
                  "children": [
                    {
                      "type": "span",
                      "className": "text-slate-500 dark:text-gray-600",
                      "props": {
                        "children": "[${item.timestamp ? new Date(item.timestamp).toLocaleTimeString() : 'N/A'}]"
                      }
                    },
                    {
                      "type": "span",
                      "className": "px-1 py-0 rounded bg-slate-200 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-green-600 dark:text-green-500",
                      "props": {
                        "children": "${item.eventType || 'Unknown'}"
                      }
                    }
                  ]
                },
                {
                  "type": "div",
                  "className": "pl-0 text-slate-600 dark:text-gray-400 break-all",
                  "props": {
                    "children": "${item.event || JSON.stringify(item)}"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
