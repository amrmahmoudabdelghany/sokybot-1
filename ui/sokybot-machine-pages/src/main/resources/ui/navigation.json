{
    "type": "div",
    "className": "h-full flex flex-col space-y-6",
    "children": [
        {
            "type": "div",
            "className": "flex justify-between items-center border-b border-border pb-2",
            "children": [
                {
                    "type": "h3",
                    "className": "text-foreground font-bold",
                    "props": {
                        "children": "Navigation & Loop"
                    }
                },
                {
                    "type": "div",
                    "className": "flex space-x-2",
                    "children": [
                        {
                            "type": "Button",
                            "variant": "outline",
                            "size": "sm",
                            "props": {
                                "onClick": "refresh",
                                "children": "Refresh"
                            }
                        },
                        {
                            "type": "Button",
                            "variant": "default",
                            "size": "sm",
                            "props": {
                                "onClick": "save",
                                "children": "Save Settings"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "div",
            "className": "grid grid-cols-1 md:grid-cols-2 gap-6",
            "children": [
                {
                    "type": "div",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "h4",
                            "className": "text-sm font-semibold text-amber-500 mb-3 uppercase tracking-wider",
                            "props": {
                                "children": "Town Loop"
                            }
                        },
                        {
                            "type": "div",
                            "className": "space-y-4",
                            "children": [
                                {
                                    "type": "div",
                                    "className": "flex items-center space-x-2",
                                    "children": [
                                        {
                                            "type": "Checkbox",
                                            "props": {
                                                "checked": "${settings.loopInTown}",
                                                "onCheckedChange": "update",
                                                "name": "loopInTown"
                                            }
                                        },
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Enable Town Loop"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "className": "space-y-1",
                                    "children": [
                                        {
                                            "type": "Label",
                                            "props": {
                                                "children": "Script Path"
                                            }
                                        },
                                        {
                                            "type": "Input",
                                            "props": {
                                                "value": "${settings.scriptPath}",
                                                "onChange": "update",
                                                "name": "scriptPath",
                                                "placeholder": "Path to training area script"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "div",
                    "className": "bg-card border border-border rounded p-4 shadow-sm",
                    "children": [
                        {
                            "type": "h4",
                            "className": "text-sm font-semibold text-blue-500 mb-3 uppercase tracking-wider",
                            "props": {
                                "children": "Current Position"
                            }
                        },
                        {
                            "type": "div",
                            "className": "grid grid-cols-2 gap-4 text-center",
                            "children": [
                                {
                                    "type": "div",
                                    "className": "p-3 bg-muted rounded",
                                    "children": [
                                        {
                                            "type": "div",
                                            "className": "text-xs text-muted-foreground uppercase",
                                            "props": {
                                                "children": "X Coordinate"
                                            }
                                        },
                                        {
                                            "type": "div",
                                            "className": "text-lg font-mono font-bold text-foreground",
                                            "props": {
                                                "children": "${position.x}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "className": "p-3 bg-muted rounded",
                                    "children": [
                                        {
                                            "type": "div",
                                            "className": "text-xs text-muted-foreground uppercase",
                                            "props": {
                                                "children": "Y Coordinate"
                                            }
                                        },
                                        {
                                            "type": "div",
                                            "className": "text-lg font-mono font-bold text-foreground",
                                            "props": {
                                                "children": "${position.y}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}