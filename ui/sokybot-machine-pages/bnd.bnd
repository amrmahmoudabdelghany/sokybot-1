Bundle-SymbolicName: ${project.groupId}.${project.artifactId}
Bundle-Name: ${project.name}
Bundle-Version: ${project.version}
Bundle-Description: ${project.description}
Export-Package: org.sokybot.machinepages, org.sokybot.machinepages.api
Import-Package: org.sokybot.runtime.*;version="[1,2)", org.sokybot.engine.api.*;version="[1,2)", org.sokybot.commons.script;version="[1,2)", org.sokybot.commons.topic;version="[1,2)", org.sokybot.proxy.*;version="[1,2)", org.sokybot.settings.api.*;version="[1,2)", org.sokybot.gameevents.*;version="[1,2)", org.sokybot.gamemodel.*;version="[1,2)", org.sokybot.webview.api.*;version="[1,2)", !groovy.*, !org.codehaus.groovy.*, !org.apache.groovy.*, *
_dump: true
