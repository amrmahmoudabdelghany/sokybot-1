#!/bin/bash
# =============================================================================
# Sokybot Development CLI ("soky")
# =============================================================================
# A unified tool to manage the Sokybot development environment.
#
# Usage:
#   soky [subcommand] [args...]
#
# =============================================================================

set -e

# =============================================================================
# Configuration
# =============================================================================

# Resolve true path of this script (handle symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Karaf Paths (Absolute)
KARAF_DIST="$ROOT_DIR/infra/sokybot-dist/target/assembly"
KARAF_BIN="$KARAF_DIST/bin"
KARAF_DATA="$KARAF_DIST/data"
KARAF_LOG="$KARAF_DATA/log/karaf.log"

# UI Paths
UI_DIR="$ROOT_DIR/ui"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# =============================================================================
# Helper Functions
# =============================================================================
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_header() { echo -e "\n${CYAN}=== $1 ===${NC}"; }

# When in Docker and assembly is missing, build backend once (writes to mounted volume)
check_karaf_dist_or_build() {
    if [ -d "$KARAF_BIN" ]; then
        return 0
    fi
    if is_in_docker; then
        log_warn "Karaf distribution not found at: $KARAF_DIST"
        log_info "Building backend once (this may take a few minutes)..."
        cmd_build backend --fast
        if [ ! -d "$KARAF_BIN" ]; then
            log_error "Backend build did not produce assembly at: $KARAF_DIST"
            exit 1
        fi
        log_success "Backend built. Starting..."
        return 0
    fi
    log_error "Karaf distribution not found at: $KARAF_DIST"
    log_warn "Please build the project first: soky build backend"
    exit 1
}

check_karaf_dist() {
    if [ ! -d "$KARAF_BIN" ]; then
        log_error "Karaf distribution not found at: $KARAF_DIST"
        log_warn "Please build the project first: soky build backend"
        exit 1
    fi
}

# Clear only the bundle cache when system JARs are newer than cache.
# This prevents Karaf from booting stale bundles after local rebuilds.
check_and_clear_stale_cache() {
    local CACHE_DIR="$KARAF_DATA/cache"
    local SYSTEM_SOKYBOT_DIR="$KARAF_DIST/system/org/sokybot"

    if [ ! -d "$CACHE_DIR" ] || [ ! -d "$SYSTEM_SOKYBOT_DIR" ]; then
        return 0
    fi

    local STALE=false
    while IFS= read -r -d '' jar; do
        if [ "$jar" -nt "$CACHE_DIR" ]; then
            STALE=true
            break
        fi
    done < <(find "$SYSTEM_SOKYBOT_DIR" -name '*.jar' -print0 2>/dev/null)

    if [ "$STALE" = true ]; then
        log_warn "Detected newer system JARs than Karaf cache. Clearing stale bundle cache..."
        rm -rf "$CACHE_DIR"
        log_success "Karaf bundle cache cleared. Fresh bundles will be loaded on startup."
    fi
}

is_process_running() {
    if pgrep -f "$1" > /dev/null; then
        return 0
    else
        return 1
    fi
}

check_port() {
    # Check if a port is listening ($1)
    if ss -lnt | grep -q ":$1 "; then
        echo -e "${GREEN}Running (Port $1)${NC}"
    else
        echo -e "${RED}Stopped (Port $1)${NC}"
    fi
}

is_in_docker() {
    [ -f /.dockerenv ]
}

# Extra args for mvn/mvnw when host ~/.m2 is mounted at /var/maven/.m2 (see docker-compose.yml).
maven_repo_local_args() {
    if [ -n "${SOKY_MAVEN_REPO_LOCAL:-}" ]; then
        echo "-Dmaven.repo.local=${SOKY_MAVEN_REPO_LOCAL}"
    elif [ -d "/var/maven/.m2/repository" ]; then
        echo "-Dmaven.repo.local=/var/maven/.m2/repository"
    fi
}

# $1 = absolute path to built bundle JAR. Uses file:///... bundle:update to reduce SNAPSHOT cache skew.
hot_reload_jar_at_path() {
    local FILE="$1"
    if [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
        log_warn "hot_reload_jar_at_path: missing or not a file: $FILE"
        return 1
    fi
    if [[ "$FILE" != *"target/"* ]] || [[ "$FILE" != *".jar" ]]; then
        return 1
    fi
    if [[ "$FILE" == *"-sources.jar" ]] || [[ "$FILE" == *"-javadoc.jar" ]] || [[ "$FILE" == *"target/assembly/data/"* ]]; then
        return 1
    fi

    if [ ! -d "$KARAF_BIN" ]; then
        log_warn "Karaf not available; skip hot-reload for $(basename "$FILE")"
        return 1
    fi

    local JAR_NAME
    JAR_NAME=$(basename "$FILE")
    local BASE_BUNDLE_NAME
    BASE_BUNDLE_NAME=$(echo "$JAR_NAME" | sed -r 's/-[0-9]+(\.[0-9]+)*(-SNAPSHOT)?\.jar$//')
    local SYSTEM_DIR="$KARAF_DIST/system/org/sokybot/${BASE_BUNDLE_NAME}/1.0-SNAPSHOT"

    log_info "Hot-reload: $JAR_NAME ($BASE_BUNDLE_NAME)"

    if [ -d "$SYSTEM_DIR" ]; then
        cp "$FILE" "$SYSTEM_DIR/$JAR_NAME"
        log_info "Synced JAR to assembly: $SYSTEM_DIR"
    fi

    local BUNDLE_ID
    BUNDLE_ID=$("$KARAF_BIN/client" "bundle:list -s | grep $BASE_BUNDLE_NAME" 2>/dev/null | awk '{print $1}' | head -n 1)

    if [ -z "$BUNDLE_ID" ]; then
        rm -rf "$KARAF_DATA/cache"
        log_warn "Bundle '$BASE_BUNDLE_NAME' not active; cleared Karaf cache for next restart."
        return 1
    fi

    # file:///absolute/path — forces load from workspace JAR instead of stale SNAPSHOT cache
    local FILE_URI="file://${FILE}"
    log_info "bundle:update $BUNDLE_ID $FILE_URI"
    if "$KARAF_BIN/client" "bundle:update $BUNDLE_ID $FILE_URI" 2>/dev/null && \
            "$KARAF_BIN/client" "bundle:refresh $BUNDLE_ID" 2>/dev/null; then
        log_success "Hot-reloaded $BASE_BUNDLE_NAME (ID: $BUNDLE_ID)"
        return 0
    fi
    rm -rf "$KARAF_DATA/cache"
    log_warn "Karaf bundle:update failed; cleared cache — restart backend if needed."
    return 1
}

# Docker transparency wrapper
# If running on host and container is active, execute command inside container
check_docker_transparency() {
    local cmd="$1"
    if ! is_in_docker && docker compose ps --format json | grep -q '"Service":"sokybot-backend"'; then
        if [ "$(docker compose ps -q sokybot-backend)" != "" ]; then
             log_info "Redirecting '$cmd' to running Docker container..."
             docker compose exec sokybot-backend /app/infra/scripts/soky "$@"
             exit 0
        fi
    fi
}

# =============================================================================
# Subcommands: Backend
# =============================================================================

cmd_backend_start() {
    check_karaf_dist_or_build
    check_and_clear_stale_cache
    
    local FOREGROUND=false
    local WATCH=false
    for arg in "$@"; do
        case "$arg" in
            --foreground|-f) FOREGROUND=true ;;
            --watch|-w) WATCH=true ;;
        esac
    done

    if is_process_running "org.apache.karaf.main.Main"; then
        log_warn "Sokybot Backend appears to be running already."
        return
    fi
    
    # Ensure Karaf bin scripts are executable (fixes Docker volume permission issues)
    if [ -d "$KARAF_BIN" ]; then
        chmod +x "$KARAF_BIN"/* 2>/dev/null || true
    fi
    # Persistence DB path (e.g. in Docker set SOKYBOT_DB_PATH=/app/data/db)
    if [ -n "$SOKYBOT_DB_PATH" ]; then
        export KARAF_OPTS="${KARAF_OPTS:+$KARAF_OPTS }-Dsokybot.db.path=$SOKYBOT_DB_PATH"
        mkdir -p "$SOKYBOT_DB_PATH"
    fi
    # Script directories: Karaf cwd differs from project root, so pass absolute paths
    export KARAF_OPTS="${KARAF_OPTS:+$KARAF_OPTS }-Dsokybot.pages.dir=$ROOT_DIR/scripts/pages -Dsokybot.scripts.dir=$ROOT_DIR/scripts/actuators"
    if [ "$FOREGROUND" = true ]; then
        if [ "$WATCH" = true ]; then
            if is_in_docker && [ "${SOKY_JAR_WATCH_IN_CONTAINER:-}" != "1" ]; then
                log_warn "Skipping in-container JAR watch (unreliable on bind mounts). On host run: soky backend watch-host"
                log_warn "Or set SOKY_JAR_WATCH_IN_CONTAINER=1 and use backend start --watch."
            else
                log_info "Starting JAR hot-reload watcher..."
                cmd_watch &
            fi
        fi
        log_info "Starting Sokybot Backend in FOREGROUND mode..."
        # In foreground mode, we use karaf server
        export KARAF_REDIRECT="/dev/stdout"
        "$KARAF_BIN/karaf" server
    else
        log_info "Starting Sokybot Backend (Server Mode)..."
        "$KARAF_BIN/start"
        log_success "Backend started in background."
        log_info "Tail logs with: soky backend logs"
        log_info "Attach shell with: soky backend shell"
        if [ "$WATCH" = true ]; then
            if is_in_docker && [ "${SOKY_JAR_WATCH_IN_CONTAINER:-}" != "1" ]; then
                log_warn "Skipping in-container JAR watch. On host run: soky backend watch-host"
            else
                log_info "Starting JAR hot-reload watcher..."
                cmd_watch &
            fi
        fi
    fi
}

cmd_backend_stop() {
    check_karaf_dist
    
    log_info "Stopping Sokybot Backend..."
    if [ -x "$KARAF_BIN/stop" ]; then
        "$KARAF_BIN/stop" 2>/dev/null || true
    fi
    
    # Wait for shutdown
    retry=0
    while is_process_running "org.apache.karaf.main.Main"; do
        sleep 1
        ((retry++))
        if [ $retry -gt 10 ]; then
            log_warn "Backend did not stop gracefully. Forcing kill..."
            pkill -f "org.apache.karaf.main.Main"
            break
        fi
    done
    log_success "Backend stopped."
}

cmd_backend_restart() {
    local FRESH_FLAG=false
    
    # Parse flags
    for arg in "$@"; do
        case "$arg" in
            --fresh) FRESH_FLAG=true ;;
        esac
    done
    
    cmd_backend_stop
    
    if [ "$FRESH_FLAG" = true ]; then
        log_info "Clearing Karaf cache and system state (--fresh)..."
        rm -rf "$KARAF_DATA"
        # Also clear the system repository cache if it exists in the assembly
        rm -rf "$ROOT_DIR/infra/sokybot-dist/target/assembly/data/cache"
        rm -rf "$ROOT_DIR/infra/sokybot-dist/target/assembly/system/org/sokybot"
    fi
    
    sleep 2
    cmd_backend_start
}

cmd_backend_debug() {
    check_karaf_dist
    
    if is_process_running "org.apache.karaf.main.Main"; then
        log_warn "Sokybot Backend appears to be running already."
        log_warn "Stop it first with: soky backend stop"
        return
    fi
    
    log_info "Starting Sokybot Backend in DEBUG mode (Port 5005)..."
    log_info "Attach your debugger to localhost:5005"
    export KARAF_DEBUG=true
    "$KARAF_BIN/karaf" debug
}

cmd_backend_logs() {
    local FILTER=$1
    if [ -n "$FILTER" ]; then
        log_info "Tailing logs with filter: '$FILTER' (Ctrl+C to exit)..."
        if [ -f "$KARAF_LOG" ]; then
            tail -f "$KARAF_LOG" | grep --line-buffered -i "$FILTER"
        else
            log_warn "Log file not found yet ($KARAF_LOG). Waiting..."
            while [ ! -f "$KARAF_LOG" ]; do sleep 1; done
            tail -f "$KARAF_LOG" | grep --line-buffered -i "$FILTER"
        fi
    else
        log_info "Tailing logs (Ctrl+C to exit)..."
        if [ -f "$KARAF_LOG" ]; then
            tail -f "$KARAF_LOG"
        else
            log_warn "Log file not found yet ($KARAF_LOG). Waiting..."
            while [ ! -f "$KARAF_LOG" ]; do sleep 1; done
            tail -f "$KARAF_LOG"
        fi
    fi
}

cmd_backend_shell() {
    check_karaf_dist
    log_info "Connecting to Karaf Shell..."
    "$KARAF_BIN/client"
}

cmd_backend_clean() {
    cmd_backend_stop
    
    if [ -d "$KARAF_DATA" ]; then
        log_info "Cleaning Karaf data directory..."
        rm -rf "$KARAF_DATA"
        log_success "Cache cleaned."
    else
        log_info "Nothing to clean."
    fi
}

cmd_backend_features() {
    check_karaf_dist
    log_info "Listing Sokybot Karaf features..."
    "$KARAF_BIN/client" "feature:list | grep -E '(sokybot|State)'"
}

cmd_watch() {
    if ! type inotifywait > /dev/null; then
        log_error "'inotify-tools' is not installed. Please install it to use 'watch'."
        exit 1
    fi

    log_header "Hot-Reload Watcher Active (in-container)"
    log_info "Monitoring 'target/*.jar' under $ROOT_DIR — prefer 'soky backend watch-host' from the host when using Docker."

    inotifywait -m -r -e close_write --format '%w%f' "$ROOT_DIR" | while read -r FILE; do
        if [[ "$FILE" == *"target/"*".jar" ]]; then
            hot_reload_jar_at_path "$FILE" || true
        fi
    done
}

# Host-only: reliable inotify + docker compose exec into Karaf with file:///app/... updates
cmd_watch_host() {
    if is_in_docker; then
        log_error "'backend watch-host' must run on the host, not inside the container."
        exit 1
    fi
    if ! type inotifywait > /dev/null; then
        log_error "Install 'inotify-tools' on the host (e.g. apt install inotify-tools)."
        exit 1
    fi
    cd "$ROOT_DIR" || exit 1
    if [ -z "$(docker compose ps -q sokybot-backend 2>/dev/null)" ]; then
        log_error "sokybot-backend container is not running. Start with: docker compose up -d sokybot-backend"
        exit 1
    fi

    log_header "Host Hot-Reload Watcher Active"
    log_info "Watching $ROOT_DIR for target/*.jar → docker compose exec Karaf (file:///app/...)"

    ( cd "$ROOT_DIR" && inotifywait -m -r -e close_write --format '%w%f' "$ROOT_DIR" ) | while read -r FILE; do
        if [[ "$FILE" != *"target/"*".jar" ]]; then
            continue
        fi
        if [[ "$FILE" == *"-sources.jar" ]] || [[ "$FILE" == *"-javadoc.jar" ]] || [[ "$FILE" == *"target/assembly/data/"* ]]; then
            continue
        fi
        case "$FILE" in
            "$ROOT_DIR"/*) ;;
            *)
                log_warn "Skipping JAR outside ROOT_DIR: $FILE"
                continue
                ;;
        esac
        REL="${FILE#"${ROOT_DIR}/"}"
        CONTAINER_JAR="/app/$REL"
        docker compose -f "$ROOT_DIR/docker-compose.yml" exec -T sokybot-backend \
            /app/infra/scripts/soky internal-hot-reload-jar "$CONTAINER_JAR" || true
    done
}

cmd_internal_hot_reload_jar() {
    local FILE="$1"
    if [ -z "$FILE" ]; then
        log_error "internal-hot-reload-jar: missing path"
        exit 1
    fi
    hot_reload_jar_at_path "$FILE" || exit 1
}

cmd_refresh() {
    check_docker_transparency "$@"
    local MODULE_NAME=$1
    if [ -z "$MODULE_NAME" ]; then
        log_error "Usage: soky refresh <module-name>"
        exit 1
    fi

    # Extract base name if path provided
    MODULE_NAME=$(basename "$MODULE_NAME")

    log_info "Refreshing module in Karaf: $MODULE_NAME"
    if ! is_process_running "org.apache.karaf.main.Main"; then
        log_error "Backend is not running!"
        exit 1
    fi

    BUNDLE_ID=$("$KARAF_BIN/client" "bundle:list -s | grep $MODULE_NAME" 2>/dev/null | awk '{print $1}' | head -1)
    if [ -n "$BUNDLE_ID" ]; then
        log_info "Updating bundle ID: $BUNDLE_ID"
        "$KARAF_BIN/client" "bundle:update $BUNDLE_ID"
        "$KARAF_BIN/client" "bundle:refresh $BUNDLE_ID"
        log_success "Hot-reload successful."
    else
        log_warn "Bundle '$MODULE_NAME' not found. Is it installed?"
        log_info "Try: soky deploy $MODULE_NAME"
    fi
}

# =============================================================================
# Subcommands: Frontend
# =============================================================================

cmd_ui_dev() {
    log_info "Starting Frontend Development Servers..."
    log_info "NOTE: You can access the UI at http://localhost:8182 (Backend HTTP Server)"
    log_info "      Webview dev server: http://localhost:5173"
    cd "$UI_DIR"
    npm run dev
}

# =============================================================================
# Subcommands: Build
# =============================================================================

cmd_build() {
    local TARGET=$1
    shift || true
    local FAST_FLAG=false
    
    # Parse remaining arguments for flags
    for arg in "$@"; do
        case "$arg" in
            --fast) FAST_FLAG=true ;;
        esac
    done
    
    case "$TARGET" in
        backend)
            log_header "Building Backend"
            log_info "Running Maven install..."
            cd "$ROOT_DIR"
            if [ ! -f "./mvnw" ]; then
                log_error "Maven Wrapper (mvnw) not found in $ROOT_DIR"
                exit 1
            fi
            local _mra
            _mra=$(maven_repo_local_args)
            if [ "$FAST_FLAG" = true ]; then
                log_info "Using fast profile (skipping tests and quality checks)..."
                ./mvnw clean install -P fast $_mra
            else
                log_info "Using dev profile..."
                ./mvnw clean install -P dev $_mra
            fi
            ;;
        ui)
            log_header "Building UI"
            cd "$UI_DIR"
            npm install
            npm run build
            ;;
        module)
            if [ -z "$1" ]; then
                log_error "Usage: soky build module <module-name>"
                log_info "Example: soky build module sokybot-webview"
                log_info "         soky build module ui/sokybot-webview"
                exit 1
            fi
            MODULE_NAME=$1
            log_header "Building Module: $MODULE_NAME"
            
            # Try to find module directory
            MODULE_DIR=""
            if [ -d "$ROOT_DIR/$MODULE_NAME" ]; then
                MODULE_DIR="$ROOT_DIR/$MODULE_NAME"
            elif [ -d "$ROOT_DIR/ui/$MODULE_NAME" ]; then
                MODULE_DIR="$ROOT_DIR/ui/$MODULE_NAME"
            elif [ -d "$ROOT_DIR/core/$MODULE_NAME" ]; then
                MODULE_DIR="$ROOT_DIR/core/$MODULE_NAME"
            elif [ -d "$ROOT_DIR/network/$MODULE_NAME" ]; then
                MODULE_DIR="$ROOT_DIR/network/$MODULE_NAME"
            elif [ -d "$ROOT_DIR/infra/$MODULE_NAME" ]; then
                MODULE_DIR="$ROOT_DIR/infra/$MODULE_NAME"
            fi
            
            if [ -n "$MODULE_DIR" ] && [ -f "$MODULE_DIR/pom.xml" ]; then
                log_info "Found module at: $MODULE_DIR"
                cd "$MODULE_DIR"
                local _mra
                _mra=$(maven_repo_local_args)
                mvn clean install -DskipTests -Djacoco.skip=true $_mra
            else
                log_warn "Module directory not found, trying Maven reactor..."
                cd "$ROOT_DIR"
                if [ ! -f "./mvnw" ]; then
                    log_error "Maven Wrapper (mvnw) not found in $ROOT_DIR"
                    exit 1
                fi
                local _mra
                _mra=$(maven_repo_local_args)
                ./mvnw clean install -pl "$MODULE_NAME" -am -DskipTests -Djacoco.skip=true $_mra
            fi
            ;;
        all)
            cmd_build backend "$@"
            cmd_build ui
            ;;
        *)
            echo "Usage: soky build [backend|ui|module|all] [--fast]"
            echo ""
            echo "Options:"
            echo "  backend        - Build all Java modules"
            echo "  backend --fast - Build with fast profile (skip tests/checks)"
            echo "  ui             - Build all frontend modules"
            echo "  module <name>  - Build a specific Maven module"
            echo "  all            - Build everything"
            ;;
    esac
}

cmd_test() {
    local TARGET=$1
    shift || true
    
    if [ -z "$TARGET" ]; then
        log_error "Usage: soky test <module-name> | all"
        exit 1
    fi

    if [ "$TARGET" = "all" ]; then
        log_header "Running All Tests"
        cd "$ROOT_DIR"
        local _mra
        _mra=$(maven_repo_local_args)
        ./mvnw test $_mra
    else
        log_header "Running Tests for: $TARGET"
        local _mra
        _mra=$(maven_repo_local_args)
        # Try module first
        if [ -d "$ROOT_DIR/$TARGET" ] || [ -d "$ROOT_DIR/core/$TARGET" ] || [ -d "$ROOT_DIR/game/$TARGET" ] || [ -d "$ROOT_DIR/network/$TARGET" ] || [ -d "$ROOT_DIR/ui/$TARGET" ] || [ -d "$ROOT_DIR/actuators/$TARGET" ] || [ -d "$ROOT_DIR/infra/$TARGET" ]; then
           cd "$ROOT_DIR"
           ./mvnw test -pl "$TARGET" -am $_mra
        else
           # Try searching recursively because user might provide partial name or the directory logic is complex
           cd "$ROOT_DIR"
           ./mvnw test -pl "$TARGET" -am $_mra
        fi
    fi
}

cmd_generate() {
    SCAFFOLD_SCRIPT="$SCRIPT_DIR/soky-scaffold.sh"
    if [ ! -f "$SCAFFOLD_SCRIPT" ]; then
        log_error "Scaffolding script not found at $SCAFFOLD_SCRIPT"
        exit 1
    fi
    "$SCAFFOLD_SCRIPT" "$@"
}

cmd_clean() {
    TARGET=$1
    
    case "$TARGET" in
        backend)
            cmd_backend_clean
            ;;
        maven)
            log_header "Cleaning Maven Build"
            cd "$ROOT_DIR"
            local _mra
            _mra=$(maven_repo_local_args)
            ./mvnw clean $_mra
            log_success "Maven targets cleaned."
            ;;
        all)
            cmd_backend_stop 2>/dev/null || true
            
            log_header "Cleaning Everything"
            
            # Clean Karaf data
            if [ -d "$KARAF_DATA" ]; then
                log_info "Cleaning Karaf data directory..."
                rm -rf "$KARAF_DATA"
            fi
            
            # Clean Maven targets
            log_info "Cleaning Maven build targets..."
            cd "$ROOT_DIR"
            local _mra
            _mra=$(maven_repo_local_args)
            ./mvnw clean $_mra
            
            log_success "All cleaned."
            ;;
        *)
            echo "Usage: soky clean [backend|maven|all]"
            echo ""
            echo "Options:"
            echo "  backend - Clean Karaf data directory only"
            echo "  maven   - Run mvn clean"
            echo "  all     - Clean both Karaf data and Maven targets"
            ;;
    esac
}

# =============================================================================
# Subcommands: Deploy (Build + Hot Reload)
# =============================================================================

cmd_deploy() {
    local MODULE_NAME=$1
    local NO_RESTART=false
    
    # Parse flags
    shift || true
    for arg in "$@"; do
        case "$arg" in
            --no-restart) NO_RESTART=true ;;
        esac
    done
    
    if [ -z "$MODULE_NAME" ]; then
        echo "Usage: soky deploy <module-name> [--no-restart]"
        echo ""
        echo "Builds a module and hot-redeploys it to the running Karaf instance."
        echo ""
        echo "Options:"
        echo "  --no-restart  Skip backend restart (try hot reload via Karaf)"
        echo ""
        echo "Examples:"
        echo "  soky deploy sokybot-webview       # Build and restart backend"
        echo "  soky deploy sokybot-webview --no-restart  # Try hot reload"
        exit 1
    fi
    
    log_header "Deploying Module: $MODULE_NAME"
    
    # Step 1: Find and build the module
    MODULE_DIR=""
    if [ -d "$ROOT_DIR/$MODULE_NAME" ]; then
        MODULE_DIR="$ROOT_DIR/$MODULE_NAME"
    elif [ -d "$ROOT_DIR/ui/$MODULE_NAME" ]; then
        MODULE_DIR="$ROOT_DIR/ui/$MODULE_NAME"
    elif [ -d "$ROOT_DIR/core/$MODULE_NAME" ]; then
        MODULE_DIR="$ROOT_DIR/core/$MODULE_NAME"
    elif [ -d "$ROOT_DIR/network/$MODULE_NAME" ]; then
        MODULE_DIR="$ROOT_DIR/network/$MODULE_NAME"
    elif [ -d "$ROOT_DIR/infra/$MODULE_NAME" ]; then
        MODULE_DIR="$ROOT_DIR/infra/$MODULE_NAME"
    fi
    
    if [ -z "$MODULE_DIR" ] || [ ! -f "$MODULE_DIR/pom.xml" ]; then
        log_error "Module not found: $MODULE_NAME"
        log_info "Searched in: $ROOT_DIR, ui/, core/, network/, infra/"
        exit 1
    fi
    
    log_info "Building module at: $MODULE_DIR"
    cd "$MODULE_DIR"
    local _mra
    _mra=$(maven_repo_local_args)

    if ! mvn install -DskipTests -Djacoco.skip=true -q $_mra; then
        log_error "Build failed!"
        exit 1
    fi
    log_success "Module built successfully."
    
    # Step 2: Copy built JAR to assembly system directory
    # This prevents stale JARs — Karaf loads bundles from system/, so we must sync it
    local ARTIFACT_ID
    # Correctly identify module artifactId by skipping the <parent> tag if it exists
    ARTIFACT_ID=$(sed -n '/<parent>/,/<\/parent>/d; /<artifactId>/ s/.*<artifactId>\(.*\)<\/artifactId>.*/\1/p' "$MODULE_DIR/pom.xml" | head -1 | tr -d '[:space:]')
    local VERSION="1.0-SNAPSHOT"
    local BUILT_JAR="$MODULE_DIR/target/${ARTIFACT_ID}-${VERSION}.jar"
    local SYSTEM_DIR="$KARAF_DIST/system/org/sokybot/${ARTIFACT_ID}/${VERSION}"
    
    if [ -f "$BUILT_JAR" ]; then
        if [ -d "$SYSTEM_DIR" ]; then
            log_info "Syncing JAR to assembly: $SYSTEM_DIR"
            cp "$BUILT_JAR" "$SYSTEM_DIR/${ARTIFACT_ID}-${VERSION}.jar"
            log_success "Assembly JAR updated."
        else
            log_info "Creating assembly directory: $SYSTEM_DIR"
            mkdir -p "$SYSTEM_DIR"
            cp "$BUILT_JAR" "$SYSTEM_DIR/${ARTIFACT_ID}-${VERSION}.jar"
            log_success "Assembly JAR installed."
        fi
    else
        log_warn "Built JAR not found at: $BUILT_JAR (skipping assembly sync)"
    fi
    
    # Step 3: Deploy to Karaf
    if [ "$NO_RESTART" = true ]; then
        cmd_refresh "$MODULE_NAME"
    else
        # Full restart with cache clear
        if is_process_running "org.apache.karaf.main.Main"; then
            log_info "Stopping backend..."
            cmd_backend_stop
        fi
        
        log_info "Clearing Karaf cache..."
        rm -rf "$KARAF_DATA"
        
        log_info "Starting backend..."
        cmd_backend_start
        
        log_success "Module deployed! Backend is starting..."
        log_info "Check logs with: soky backend logs"
    fi
}

# =============================================================================
# Subcommands: Status & Diagnostics
# =============================================================================

cmd_status() {
    log_header "Sokybot Status"
    
    echo -n "Backend Process (Java): "
    if is_process_running "org.apache.karaf.main.Main"; then
        echo -e "${GREEN}Running (PID $(pgrep -f org.apache.karaf.main.Main | head -1))${NC}"
    else
        echo -e "${RED}Stopped${NC}"
    fi

    echo -n "Backend API (Port 8182): "
    check_port 8182
    
    echo -n "Backend Debug (Port 5005): "
    if ss -lnt | grep -q ":5005 "; then
        echo -e "${GREEN}Running (Debug Mode)${NC}"
    else
        echo -e "${YELLOW}Not Active${NC} (start with: soky backend debug)"
    fi
    
    echo ""
    echo -e "${YELLOW}Frontend Dev Servers:${NC}"
    echo -n "  Webview (Port 5173): "
    check_port 5173
}

cmd_setup() {
    log_header "Environment Setup Check"
    
    # Java
    echo -n "Java (11+): "
    if type -p java > /dev/null; then
        JAVA_VER=$(java -version 2>&1 | head -n 1 | awk -F '"' '{print $2}')
        echo -e "${GREEN}Found ($JAVA_VER)${NC}"
    else
        echo -e "${RED}Not Found${NC}"
    fi
    
    # Maven
    echo -n "Maven: "
    if [ -f "$ROOT_DIR/mvnw" ]; then
        echo -e "${GREEN}Found (Wrapper)${NC}"
    else
        echo -e "${RED}Not Found (Missing mvnw)${NC}"
    fi
    
    # Node
    echo -n "Node.js (18+): "
    if type -p node > /dev/null; then
        NODE_VER=$(node -v)
        echo -e "${GREEN}Found ($NODE_VER)${NC}"
    else
        echo -e "${RED}Not Found${NC}"
    fi
    
    # npm
    echo -n "npm: "
    if type -p npm > /dev/null; then
        NPM_VER=$(npm -v)
        echo -e "${GREEN}Found ($NPM_VER)${NC}"
    else
        echo -e "${RED}Not Found${NC}"
    fi
}

cmd_install() {
    log_header "Installing 'soky' CLI"
    
    BIN_DIR="$HOME/bin"
    TARGET_LINK="$BIN_DIR/soky"
    
    if [ ! -d "$BIN_DIR" ]; then
        log_info "Creating $BIN_DIR..."
        mkdir -p "$BIN_DIR"
    fi
    
    if [ -L "$TARGET_LINK" ]; then
        rm "$TARGET_LINK"
    fi
    
    ln -s "$SCRIPT_DIR/soky" "$TARGET_LINK"
    log_success "Linked 'soky' to $TARGET_LINK"
    
    # Check PATH
    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warn "Directory $BIN_DIR is not in your PATH."
        log_warn "Add the following to your ~/.bashrc or ~/.zshrc:"
        echo -e "${YELLOW}export PATH=\"\$HOME/bin:\$PATH\"${NC}"
    else
        log_success "Directory $BIN_DIR is already in PATH."
    fi
    
    log_info "You can now run 'soky status' from anywhere!"
}

# =============================================================================
# Subcommands: Interactive
# =============================================================================

cmd_interactive() {
    log_header "Sokybot Interactive Mode"
    echo "Select a command to run:"
    
    options=(
        "Status (Check services)"
        "Start Backend"
        "Stop Backend"
        "Restart Backend"
        "Tail Logs"
        "Shell (Karaf)"
        "Start UI Dev Servers"
        "Build Backend"
        "Build UI"
        "Deploy Module..."
        "Exit"
    )
    
    select opt in "${options[@]}"; do
        case $opt in
            "Status (Check services)")
                cmd_status
                ;;
            "Start Backend")
                cmd_backend_start
                ;;
            "Stop Backend")
                cmd_backend_stop
                ;;
            "Restart Backend")
                cmd_backend_restart
                ;;
            "Tail Logs")
                cmd_backend_logs
                ;;
            "Shell (Karaf)")
                cmd_backend_shell
                ;;
            "Start UI Dev Servers")
                cmd_ui_dev
                ;;
            "Build Backend")
                cmd_build backend
                ;;
            "Build UI")
                cmd_build ui
                ;;
            "Deploy Module...")
                read -p "Enter module name (e.g., sokybot-webview): " mod_name
                if [ -n "$mod_name" ]; then
                    cmd_deploy "$mod_name"
                fi
                ;;
            "Exit")
                break
                ;;
            *) echo "Invalid option $REPLY";;
        esac
        echo ""
        echo "Press Enter to see menu again, or Ctrl+C to exit."
    done
}

# =============================================================================
# Global
# =============================================================================

cmd_kill() {
    log_warn "Force killing all Sokybot processes..."
    pkill -f "org.apache.karaf.main.Main" && log_success "Killed Karaf (Java)" || log_info "No Karaf process found."
    pkill -f "vite" && log_success "Killed Vite (Node)" || log_info "No Vite process found."
    log_success "Cleanup complete."
}

cmd_help() {
    echo "Sokybot Management CLI"
    echo ""
    echo "Usage: soky [command] [subcommand]"
    echo ""
    echo "Core:"
    echo "  install       - Install 'soky' to ~/bin for global access"
    echo "  setup         - Verify environment requirements"
    echo "  status        - Show status of all services"
    echo "  kill          - Force kill all processes"
    echo ""
    echo "Backend:"
    echo "  backend start [--foreground] [--watch] - Start Karaf backend"
    echo "  backend stop          - Stop Karaf backend"
    echo "  backend restart [--fresh] - Restart Karaf backend"
    echo "  backend shell         - Connect to Karaf console"
    echo "  backend logs [filter] - Tail logs"
    echo "  backend watch         - JAR hot-reload watcher (in-container; use watch-host from host with Docker)"
    echo "  backend watch-host    - Host watcher → docker exec Karaf (file:///app/...); recommended with compose"
    echo "  backend debug         - Start in debug mode (port 5005)"
    echo "  backend clean         - Clean Karaf cache"
    echo "  backend features      - List installed Sokybot features"
    echo ""
    echo "Frontend:"
    echo "  ui dev           - Start webview dev server"
    echo ""
    echo "Build:"
    echo "  build backend [--fast]  - Build Java project"
    echo "  build ui                - Build Frontend"
    echo "  build module <name>     - Build specific Maven module"
    echo "  build all [--fast]      - Build everything"
    echo ""
    echo "Deploy:"
    echo "  deploy <module>          - Build module and restart backend with fresh cache"
    echo "  deploy <module> --no-restart  - Build and try hot reload (may not always work)"
    echo ""
    echo "Test:"
    echo "  test <module>    - Run unit tests for a module"
    echo "  test all         - Run all unit tests"
    echo ""
    echo "Generate:"
    echo "  generate bundle <category> <name>  - Create a new OSGi bundle"
    echo ""
    echo "Clean:"
    echo "  clean backend    - Clean Karaf data directory"
    echo "  clean maven      - Run mvn clean"
    echo "  clean all        - Clean everything"
    echo ""
}

# =============================================================================
# Main Dispatch
# =============================================================================

case "$1" in
    internal-hot-reload-jar)
        shift
        cmd_internal_hot_reload_jar "${1:-}"
        ;;
    backend|ba)
        case "$2" in
            start)    cmd_backend_start "${@:3}" ;;
            stop)     check_docker_transparency "$@"; cmd_backend_stop ;;
            restart)  check_docker_transparency "$@"; shift 2; cmd_backend_restart "$@" ;;
            debug)    cmd_backend_debug ;;
            clean)    check_docker_transparency "$@"; cmd_backend_clean ;;
            logs|l)   check_docker_transparency "$@"; shift 2; cmd_backend_logs "$@" ;;
            shell|sh) check_docker_transparency "$@"; cmd_backend_shell ;;
            features) check_docker_transparency "$@"; cmd_backend_features ;;
            watch-host|wh) cmd_watch_host ;;
            watch|w)  check_docker_transparency "$@"; cmd_watch ;;
            *)        cmd_help ;;
        esac
        ;;
    ui)
        case "$2" in
            dev)     cmd_ui_dev ;;
            *)       cmd_help ;;
        esac
        ;;
    build|b)
        shift
        cmd_build "$@"
        ;;
    deploy|d)
        shift
        cmd_deploy "$@"
        ;;
    refresh|ref|r)
        shift
        cmd_refresh "$@"
        ;;
    test|t)
        shift
        cmd_test "$@"
        ;;
    generate|gen|g)
        shift
        cmd_generate "$@"
        ;;
    clean)
        shift
        cmd_clean "$@"
        ;;
    status|st)    cmd_status ;;
    setup)        cmd_setup ;;
    kill)         cmd_kill ;;
    install)      cmd_install ;;
    
    # Shortcuts
    start)
        cmd_backend_start
        ;;
    stop)
        cmd_backend_stop
        ;;
    restart)
        shift || true
        cmd_backend_restart "$@"
        ;;
    logs|log|l)
        shift || true
        cmd_backend_logs "$@"
        ;;
    shell|sh)
        cmd_backend_shell
        ;;
    "")
        cmd_interactive
        ;;
    *)
        cmd_help
        ;;
esac
