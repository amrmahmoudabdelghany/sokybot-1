<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence 
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    
    <persistence-unit name="sokybot-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Application entities -->
        <!-- Note: GroupInfo and MachineInfo are currently managed via file/JSON repository -->

        
        <!-- Game entities -->
        <class>org.sokybot.persistence.entities.GameInfo</class>
        <class>org.sokybot.persistence.entities.ItemEntity</class>
        <class>org.sokybot.persistence.entities.NPCEntity</class>
        <class>org.sokybot.persistence.entities.ShopEntity</class>
        <class>org.sokybot.persistence.entities.SkillEntity</class>
        <class>org.sokybot.persistence.entities.TeleportEntity</class>
        <class>org.sokybot.persistence.entities.TeleportDestinationEntity</class>
        <class>org.sokybot.persistence.entities.MonsterSpawnPointEntity</class>
        <class>org.sokybot.persistence.entities.PortalEntity</class>
        <class>org.sokybot.persistence.entities.SectorRef</class>
        <class>org.sokybot.persistence.entities.ObjectNavMesh</class>
        <class>org.sokybot.persistence.entities.LvlEXP</class>
        <class>org.sokybot.persistence.entities.MasteryData</class>
        <class>org.sokybot.persistence.entities.SilkroadEntity</class>
        <class>org.sokybot.persistence.entities.SilkroadType</class>
        <class>org.sokybot.persistence.entities.DivisionInfo</class>
        <class>org.sokybot.persistence.entities.Division</class>
        
        <!-- Navigation mesh entities -->
        <class>org.sokybot.persistence.entities.navmesh.NavCellRef</class>
        <class>org.sokybot.persistence.entities.navmesh.NavBorderRef</class>
        <class>org.sokybot.persistence.entities.navmesh.NavCellLinkRef</class>
        <class>org.sokybot.persistence.entities.navmesh.NavObjectRef</class>
        <class>org.sokybot.persistence.entities.navmesh.ObjectLineRef</class>
        <class>org.sokybot.persistence.entities.navmesh.ObjectGroundTriRef</class>
        <class>org.sokybot.persistence.entities.navmesh.Position</class>
        
        <!-- Note: Properties are provided programmatically via PersistenceContextManagerImpl -->
        <!-- Database connection settings are configured per-game in the manager -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
