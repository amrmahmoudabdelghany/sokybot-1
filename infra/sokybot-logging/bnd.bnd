_dsannotations-options: norequirements
Bundle-SymbolicName: ${project.groupId}.${project.artifactId}
Bundle-Name: ${project.name}
Bundle-Version: ${project.version}
Bundle-Description: ${project.description}
Export-Package: org.sokybot.logging.api
Import-Package: org.osgi.service.log.*;version="[1.4,2)", org.osgi.service.component.annotations.*;version="[1.3,2)", io.projectreactor.core.*;version="[3.5,4)", org.slf4j.*;version="[1.7,2)", *
