<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sokybot</groupId>
        <artifactId>sokybot-infra-aggregator</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sokybot-logging</artifactId>
    <packaging>bundle</packaging>
    <name>sokybot-logging</name>
    <description>Central logging ring buffer and streaming service for Sokybot (SYSTEM/GROUP/MACHINE).</description>

    <dependencies>
        <!-- OSGi Log Service (implemented by Pax Logging) -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.log</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- OSGi Declarative Services annotations -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Reactor for Flux/Sinks -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J API for internal logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${dependency.slf4j-api.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${plugin.bundle.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <!-- Generate DS metadata but do NOT add osgi.service Require-Capability
                             entries for referenced services like LogReaderService. Karaf's log
                             feature provides the service at runtime, and strict resolver checks
                             would otherwise fail the sokybot-logging bundle at boot. -->
                        <_dsannotations-options>norequirements</_dsannotations-options>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.name}</Bundle-Name>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Bundle-Description>${project.description}</Bundle-Description>
                        <Export-Package>
                            org.sokybot.logging.api
                        </Export-Package>
                        <Import-Package>
                            org.osgi.service.log.*;version="[1.4,2)",
                            org.osgi.service.component.annotations.*;version="[1.3,2)",
                            io.projectreactor.core.*;version="[3.5,4)",
                            org.slf4j.*;version="[1.7,2)",
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

